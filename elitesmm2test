local RoleService = require(servicesFolder:WaitForChild("RoleService"))
local WeaponService = require(servicesFolder:WaitForChild("WeaponService"))
local MovementService = require(servicesFolder:WaitForChild("MovementService"))
local PickupService = require(servicesFolder:WaitForChild("PickupService"))
local AnnouncementService = require(servicesFolder:WaitForChild("AnnouncementService"))

local remotesFolder = ReplicatedStorage:FindFirstChild(Config.RemoteFolderName)
if not remotesFolder then
    remotesFolder = Instance.new("Folder")
    remotesFolder.Name = Config.RemoteFolderName
    remotesFolder.Parent = ReplicatedStorage
end

local function getRemote(className, name)
    local remote = remotesFolder:FindFirstChild(name)
    if remote and not remote:IsA(className) then
        remote:Destroy()
        remote = nil
    end
    if not remote then
        remote = Instance.new(className)
        remote.Name = name
        remote.Parent = remotesFolder
    end
    return remote
end

local Remotes = {
    Action = getRemote("RemoteEvent", "Action"),
    Push = getRemote("RemoteEvent", "Push"),
    RequestSnapshot = getRemote("RemoteFunction", "RequestSnapshot"),
}

local context = {
    Config = Config,
    Remotes = Remotes,
}

function context.Notify(player, message, kind)
    if player and player.Parent == Players then
        Remotes.Push:FireClient(player, "Notification", {
            Message = tostring(message),
            Kind = kind or "Info",
        })
    end
end

-- Initialize services in dependency order.
DataService.Init(context)
context.DataService = DataService
RoleService.Init(context)
context.RoleService = RoleService
WeaponService.Init(context)
MovementService.Init(context)
PickupService.Init(context)
AnnouncementService.Init(context)

Remotes.RequestSnapshot.OnServerInvoke = function(player)
    local dataSnapshot = DataService.GetSnapshot(player)
    local roleSnapshot = RoleService.GetSnapshot(player)
    return {
        Version = Config.Version,
        Stats = dataSnapshot.Stats,
        Settings = dataSnapshot.Settings,
        RoleInspectionAllowed = roleSnapshot.RoleInspectionAllowed,
        OwnRole = roleSnapshot.OwnRole,
        Roles = roleSnapshot.Roles,
        IsStudio = RunService:IsStudio(),
    }
end

Remotes.Action.OnServerEvent:Connect(function(player, action, payload)
    if action == "SavePreference" and type(payload) == "table" then
        local saved = DataService.SavePreference(player, payload.Key, payload.Value)
        if not saved then
            context.Notify(player, "That setting could not be saved.", "Warning")
        end
    elseif action == "RequestRespawn" then
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health > 0 then return end
        local now = os.clock()
        local last = player:GetAttribute("LastRespawnRequest") or 0
        if now - last < 5 then return end
        player:SetAttribute("LastRespawnRequest", now)
        task.spawn(function()
            pcall(function()
                player:LoadCharacterAsync()
            end)
        end)
    end
end)

print("[ElitesSystems] Server started. Version " .. Config.Version)

