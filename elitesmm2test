local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local PickupService = {}
local context
local connected = {}

local function getPromptParent(instance)
    if instance:IsA("BasePart") then return instance end
    if instance:IsA("Model") then
        return instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function attachPickup(instance)
    if connected[instance] then return end
    local part = getPromptParent(instance)
    if not part then
        warn("[ElitesSystems] GoldPickup needs a BasePart or a Model containing one:", instance:GetFullName())
        return
    end
    connected[instance] = true

    local prompt = part:FindFirstChild("ElitesGoldPrompt")
    if not prompt then
        prompt = Instance.new("ProximityPrompt")
        prompt.Name = "ElitesGoldPrompt"
        prompt.ActionText = "Collect"
        prompt.ObjectText = "Gold"
        prompt.KeyboardKeyCode = Enum.KeyCode.E
        prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = 10
        prompt.RequiresLineOfSight = true
        prompt.Parent = part
    end

    prompt.Triggered:Connect(function(player)
        if instance:GetAttribute("Collected") then return end
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid or humanoid.Health <= 0 then return end
        if (root.Position - part.Position).Magnitude > prompt.MaxActivationDistance + 3 then return end

        instance:SetAttribute("Collected", true)
        prompt.Enabled = false
        local amount = math.clamp(math.floor(tonumber(instance:GetAttribute("GoldValue")) or 1), 1, 1000)
        context.DataService.AddStat(player, "Gold", amount)
        context.Notify(player, "+" .. tostring(amount) .. " Gold", "Success")
        instance:Destroy()
    end)
end

function PickupService.Init(ctx)
    context = ctx
    for _, item in ipairs(CollectionService:GetTagged(context.Config.PickupTag)) do
        attachPickup(item)
    end
    CollectionService:GetInstanceAddedSignal(context.Config.PickupTag):Connect(attachPickup)
    CollectionService:GetInstanceRemovedSignal(context.Config.PickupTag):Connect(function(instance)
        connected[instance] = nil
    end)
end

return PickupService

