local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local DataService = {}
local context
local store
local cache = {}
local saveScheduled = {}
local pendingStats = {}

local STAT_KEYS = { Kills = true, Deaths = true, Gold = true, SpeedKills = true }

local function makeDefaultData(Config)
    local settings = {}
    for key, value in pairs(Config.DefaultSettings) do
        settings[key] = value
    end
    return {
        Version = 1,
        Stats = { Kills = 0, Deaths = 0, Gold = 0, SpeedKills = 0 },
        Settings = settings,
    }
end

local function sanitizeData(raw, Config)
    local data = makeDefaultData(Config)
    if type(raw) ~= "table" then
        return data
    end

    if type(raw.Stats) == "table" then
        for key in pairs(STAT_KEYS) do
            local value = tonumber(raw.Stats[key])
            if value then
                data.Stats[key] = math.clamp(math.floor(value), 0, 1000000000)
            end
        end
    end

    if type(raw.Settings) == "table" then
        for key in pairs(Config.SavedBooleanSettings) do
            if type(raw.Settings[key]) == "boolean" then
                data.Settings[key] = raw.Settings[key]
            end
        end
        if raw.Settings.Language == "en" or raw.Settings.Language == "es" then
            data.Settings.Language = raw.Settings.Language
        end
    end
    return data
end

local function setLeaderstat(player, name, value)
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then
        leaderstats = Instance.new("Folder")
        leaderstats.Name = "leaderstats"
        leaderstats.Parent = player
    end
    local stat = leaderstats:FindFirstChild(name)
    if not stat then
        stat = Instance.new("IntValue")
        stat.Name = name
        stat.Parent = leaderstats
    end
    stat.Value = value
end

local function publish(player)
    local data = cache[player]
    if not data then return end
    for key, value in pairs(data.Stats) do
        player:SetAttribute(key, value)
        setLeaderstat(player, key, value)
    end
    player:SetAttribute("DataLoaded", true)
end

function DataService.Get(player)
    return cache[player]
end

function DataService.GetSnapshot(player)
    local data = cache[player]
    if not data then
        return { Stats = { Kills = 0, Deaths = 0, Gold = 0, SpeedKills = 0 }, Settings = {} }
    end
    local stats = table.clone(data.Stats)
    local settings = table.clone(data.Settings)
    return { Stats = stats, Settings = settings }
end

function DataService.AddStat(player, key, amount)
    if not STAT_KEYS[key] or not player or player.Parent ~= Players then return end
    amount = math.floor(tonumber(amount) or 0)
    if not cache[player] then
        pendingStats[player] = pendingStats[player] or {}
        pendingStats[player][key] = (pendingStats[player][key] or 0) + amount
        return
    end
    cache[player].Stats[key] = math.clamp((cache[player].Stats[key] or 0) + amount, 0, 1000000000)
    player:SetAttribute(key, cache[player].Stats[key])
    setLeaderstat(player, key, cache[player].Stats[key])
    DataService.ScheduleSave(player)
end

function DataService.SavePreference(player, key, value)
    if not cache[player] then return false end
    if context.Config.SavedBooleanSettings[key] then
        if type(value) ~= "boolean" then return false end
    elseif key == "Language" then
        if value ~= "en" and value ~= "es" then return false end
    else
        return false
    end
    cache[player].Settings[key] = value
    DataService.ScheduleSave(player)
    return true
end

function DataService.ScheduleSave(player)
    if saveScheduled[player] then return end
    saveScheduled[player] = true
    task.delay(8, function()
        saveScheduled[player] = nil
        if player.Parent == Players then
            DataService.Save(player)
        end
    end)
end

function DataService.Save(player)
    local data = cache[player]
    if not data or not store then return false end
    local payload = {
        Version = 1,
        Stats = table.clone(data.Stats),
        Settings = table.clone(data.Settings),
    }
    local ok, err = pcall(function()
        store:UpdateAsync("u_" .. tostring(player.UserId), function()
            return payload
        end)
    end)
    if not ok then
        warn("[ElitesSystems] Could not save " .. player.Name .. ": " .. tostring(err))
    end
    return ok
end

local function loadPlayer(player)
    if cache[player] then return end
    local raw
    local ok, err = pcall(function()
        raw = store:GetAsync("u_" .. tostring(player.UserId))
    end)
    if not ok then
        warn("[ElitesSystems] Data load failed for " .. player.Name .. "; using defaults: " .. tostring(err))
    end
    if player.Parent ~= Players then return end
    cache[player] = sanitizeData(raw, context.Config)
    local queued = pendingStats[player]
    if queued then
        for key, amount in pairs(queued) do
            if STAT_KEYS[key] then
                cache[player].Stats[key] = math.clamp(cache[player].Stats[key] + amount, 0, 1000000000)
            end
        end
        pendingStats[player] = nil
    end
    publish(player)
end

function DataService.Init(ctx)
    context = ctx
    store = DataStoreService:GetDataStore(context.Config.DataStoreName)

    Players.PlayerAdded:Connect(function(player)
        loadPlayer(player)
    end)
    for _, player in ipairs(Players:GetPlayers()) do
        task.spawn(loadPlayer, player)
    end

    Players.PlayerRemoving:Connect(function(player)
        DataService.Save(player)
        cache[player] = nil
        saveScheduled[player] = nil
        pendingStats[player] = nil
    end)

    game:BindToClose(function()
        for _, player in ipairs(Players:GetPlayers()) do
            DataService.Save(player)
        end
    end)
end

return DataService

