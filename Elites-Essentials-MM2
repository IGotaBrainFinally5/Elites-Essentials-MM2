local function Cleanup()
    GlobalStop = true
    if FeatureModules and FeatureModules.CoinCollection and FeatureModules.CoinCollection.Stop then
        pcall(FeatureModules.CoinCollection.Stop)
    end
    for _, c in ipairs(Connections) do
        pcall(function() c:Disconnect() end)
    end
    for i = #Animators, 1, -1 do Animators[i] = nil end
    if Gui then pcall(function() Gui:Destroy() end) end
    if Diag.Gui then pcall(function() Diag.Gui:Destroy() end) end
end

