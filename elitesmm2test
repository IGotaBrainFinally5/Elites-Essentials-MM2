local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local WeaponService = {}
local context
local lastShotAt = {}
local trackedHumanoids = {}
local lastDamager = {}
local lastKillAt = {}

local function isFiniteVector3(value)
    return typeof(value) == "Vector3"
        and value.X == value.X and value.Y == value.Y and value.Z == value.Z
        and math.abs(value.X) < 10000 and math.abs(value.Y) < 10000 and math.abs(value.Z) < 10000
end

local function getHumanoidFromHit(instance)
    local model = instance and instance:FindFirstAncestorOfClass("Model")
    if not model then return nil, nil end
    return model:FindFirstChildOfClass("Humanoid"), model
end

local function trackHumanoid(humanoid, model)
    if trackedHumanoids[humanoid] then return end
    trackedHumanoids[humanoid] = true
    humanoid.Died:Connect(function()
        local victim = Players:GetPlayerFromCharacter(model)
        if victim then
            context.DataService.AddStat(victim, "Deaths", 1)
        end
        local attacker = lastDamager[humanoid]
        if attacker and attacker.Parent == Players and attacker ~= victim then
            context.DataService.AddStat(attacker, "Kills", 1)
            local now = os.clock()
            local previousKill = lastKillAt[attacker]
            if previousKill and now - previousKill <= (context.Config.SpeedKillWindow or 5) then
                context.DataService.AddStat(attacker, "SpeedKills", 1)
            end
            lastKillAt[attacker] = now
            context.Remotes.Push:FireAllClients("KillFeed", {
                Killer = attacker.DisplayName,
                Victim = victim and victim.DisplayName or model.Name,
            })
        end
        local root = model:FindFirstChild("HumanoidRootPart")
        if root then
            context.RoleService.MarkWitnesses(root.Position, attacker)
        end
        lastDamager[humanoid] = nil
    end)
end

local function fire(player, direction)
    if not isFiniteVector3(direction) then return end
    local now = os.clock()
    local weapon = context.Config.Weapons.TrainingPistol
    local previous = lastShotAt[player] or 0
    if now - previous < weapon.Cooldown then return end
    lastShotAt[player] = now

    if player:GetAttribute("EquippedWeapon") ~= "TrainingPistol" then return end
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local head = character and character:FindFirstChild("Head")
    if not character or not humanoid or humanoid.Health <= 0 or not head then return end

    local magnitude = direction.Magnitude
    if magnitude < 0.9 or magnitude > 1.1 then return end
    local unitDirection = direction.Unit

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }
    params.IgnoreWater = true

    local result = Workspace:Raycast(head.Position, unitDirection * weapon.Range, params)
    context.Remotes.Push:FireClient(player, "WeaponFired", { Weapon = "TrainingPistol" })
    if not result then return end

    local targetHumanoid, targetModel = getHumanoidFromHit(result.Instance)
    if not targetHumanoid or targetHumanoid.Health <= 0 then return end
    if targetModel == character then return end

    local targetPlayer = Players:GetPlayerFromCharacter(targetModel)
    if targetPlayer and player.Team ~= nil and targetPlayer.Team == player.Team then
        return
    end

    local partName = result.Instance.Name
    local isTorso = partName == "Torso" or partName == "UpperTorso" or partName == "LowerTorso"
    local damage = isTorso
        and math.random(weapon.TorsoDamageMin, weapon.TorsoDamageMax)
        or weapon.OtherDamage

    trackHumanoid(targetHumanoid, targetModel)
    lastDamager[targetHumanoid] = player
    targetHumanoid:TakeDamage(damage)

    context.Remotes.Push:FireClient(player, "HitConfirmed", {
        Target = targetModel.Name,
        Part = partName,
        Damage = damage,
        Torso = isTorso,
    })
end

function WeaponService.Init(ctx)
    context = ctx
    Players.PlayerAdded:Connect(function(player)
        player:SetAttribute("EquippedWeapon", "TrainingPistol")
    end)
    for _, player in ipairs(Players:GetPlayers()) do
        player:SetAttribute("EquippedWeapon", "TrainingPistol")
    end
    context.Remotes.Action.OnServerEvent:Connect(function(player, action, payload)
        if action == "FireWeapon" and type(payload) == "table" then
            fire(player, payload.Direction)
        end
    end)
    Players.PlayerRemoving:Connect(function(player)
        lastShotAt[player] = nil
        lastKillAt[player] = nil
    end)
end

return WeaponService

