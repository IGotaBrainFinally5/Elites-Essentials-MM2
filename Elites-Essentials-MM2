local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local TAG     = "[MM2-DIAG]"
local diagLog = {}

local function log(level, msg)
    table.insert(diagLog, string.format("[%s] %s", level, msg))
    if level == "ERR" then
        warn(TAG .. " " .. msg)
    else
        print(TAG .. " " .. msg)
    end
end

------------------------------------------------------------------
-- 0. config
------------------------------------------------------------------
local CONFIG = {
    collectDelay   = 0.10,   -- seconds between teleports
    scanInterval   = 1.50,   -- seconds between full scans
    noCoinReset    = 15.0,   -- idle seconds before reset fires
    autoReset      = true,   -- kill character when idle and alive
    matchNames     = {
        "coin", "cash", "candy", "treat", "sweet",
        "coinbag", "candybag", "candypile",
    },
}

local state = {
    enabled     = false,
    noCoinTimer = 0,
    farmThread  = nil,
}

------------------------------------------------------------------
-- 1. wait for the game to finish loading
------------------------------------------------------------------
if not game:IsLoaded() then
    log("INFO", "game not loaded — waiting")
    game.Loaded:Wait()
    log("INFO", "game loaded")
else
    log("INFO", "game already loaded")
end

------------------------------------------------------------------
-- 2. wait for LocalPlayer
------------------------------------------------------------------
local player = Players.LocalPlayer
if not player then
    log("WARN", "LocalPlayer nil — waiting up to 10s")
    local t0 = os.clock()
    repeat task.wait(0.1) until Players.LocalPlayer or (os.clock() - t0) > 10
    player = Players.LocalPlayer
end
if not player then
    log("ERR", "FATAL: LocalPlayer still nil after 10s")
    return
end
log("INFO", "LocalPlayer = " .. player.Name)

------------------------------------------------------------------
-- 3. resolve PlayerGui (CoreGui fallback)
------------------------------------------------------------------
local playerGui
local pgOk, pgErr = pcall(function()
    playerGui = player:WaitForChild("PlayerGui", 10)
end)
if not pgOk or not playerGui then
    log("ERR", "PlayerGui unavailable: " .. tostring(pgErr))
    local cgOk, cg = pcall(function() return game:GetService("CoreGui") end)
    if cgOk and cg then
        playerGui = cg
        log("WARN", "falling back to CoreGui")
    else
        log("ERR", "FATAL: no GUI parent reachable")
        return
    end
end
log("INFO", "GUI parent = " .. playerGui:GetFullName())

------------------------------------------------------------------
-- 4. clear previous instance
------------------------------------------------------------------
local existing = playerGui:FindFirstChild("MM2AutoFarmDiag")
if existing then
    existing:Destroy()
    log("INFO", "destroyed previous instance")
end

