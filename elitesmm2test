local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local CameraController = {}
CameraController.__index = CameraController

function CameraController.new()
    local self = setmetatable({}, CameraController)
    self.Player = Players.LocalPlayer
    self.RecoilEnabled = true
    self.BreatherEnabled = true
    self.Kick = 0
    self.Connection = nil

    self.Connection = RunService:BindToRenderStep("ElitesSystems_Recoil", Enum.RenderPriority.Camera.Value + 1, function(dt)
        local camera = workspace.CurrentCamera
        if camera and self.RecoilEnabled and self.Kick > 0.001 then
            camera.CFrame = camera.CFrame * CFrame.Angles(-math.rad(self.Kick), 0, 0)
        end
        self.Kick = math.max(0, self.Kick - (dt * 7.5))
    end)

    self.Player.CharacterAdded:Connect(function(character)
        local humanoid = character:WaitForChild("Humanoid", 8)
        if humanoid then
            -- The breathing option deliberately changes only camera feedback, not character animation state.
            humanoid.CameraOffset = Vector3.zero
        end
    end)
    return self
end

function CameraController:SetRecoilEnabled(enabled)
    self.RecoilEnabled = enabled == true
end

function CameraController:SetBreatherEnabled(enabled)
    self.BreatherEnabled = enabled == true
    local character = self.Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid and self.BreatherEnabled then
        humanoid.CameraOffset = Vector3.zero
    end
end

function CameraController:OnShot()
    if self.RecoilEnabled then
        self.Kick = math.min(self.Kick + 1.25, 4.5)
    end
end

function CameraController:Destroy()
    RunService:UnbindFromRenderStep("ElitesSystems_Recoil")
end

return CameraController

