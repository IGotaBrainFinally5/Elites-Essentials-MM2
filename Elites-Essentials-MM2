local Diag = {
    Lines       = {},
    Gui         = nil,
    Label       = nil,
    Failed      = false,
    Capture     = true,
    KeepOpen    = true,
    MaxLines    = 200,
}

local DIAG_COLORS = {
    OK = "120,220,160", WARN = "255,200,90", FAIL = "255,100,115", INFO = "170,185,220",
}

local function esc(s)
    s = tostring(s)
    s = s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    return s
end

local function refreshDiag()
    if not Diag.Label then return end
    local parts = {}
    local first = math.max(1, #Diag.Lines - 14)
    for i = first, #Diag.Lines do
        local l = Diag.Lines[i]
        parts[#parts + 1] = string.format(
            '<font color="rgb(%s)">[%s]</font> %s',
            DIAG_COLORS[l.kind] or DIAG_COLORS.INFO, l.kind, esc(l.msg)
        )
    end
    pcall(function()
        Diag.Label.Text = table.concat(parts, "\n")
    end)
end

local function log(kind, msg)
    local line = "[EE] [" .. kind .. "] " .. tostring(msg)
    if kind == "FAIL" or kind == "WARN" then
        warn(line)
    else
        print(line)
    end

    if not Diag.Capture and kind ~= "FAIL" then
        return
    end

    table.insert(Diag.Lines, { kind = kind, msg = tostring(msg), t = os.clock() })
    if #Diag.Lines > Diag.MaxLines then
        table.remove(Diag.Lines, 1)
    end
    if kind == "FAIL" then Diag.Failed = true end
    refreshDiag()
end

local function getLogText()
    local parts = {}
    for _, l in ipairs(Diag.Lines) do
        parts[#parts + 1] = string.format("[%s] %s", l.kind, l.msg)
    end
    return table.concat(parts, "\n")
end

local function clearLogs()
    Diag.Lines = {}
    Diag.Failed = false
    refreshDiag()
    log("INFO", "Logs cleared")
end

