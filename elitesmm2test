local Players = game:GetService("Players")

local MovementService = {}
local context
local sprintByPlayer = {}
local jumpPresetByPlayer = {}

local function getExpectedSpeed(player)
    if sprintByPlayer[player] then
        return context.Config.Movement.SprintSpeed
    end
    return context.Config.Movement.WalkSpeed
end

local function applyCharacter(player, character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid then return end
    humanoid.UseJumpPower = true
    if context.Config.DisableAutoJump then humanoid.AutoJumpEnabled = false end
    humanoid.WalkSpeed = getExpectedSpeed(player)
    local preset = jumpPresetByPlayer[player] or context.Config.Movement.DefaultJumpPreset
    humanoid.JumpPower = context.Config.Movement.JumpPresets[preset] or 50

    humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
        if not humanoid.Parent then return end
        local expected = context.Config.Movement.JumpPresets[jumpPresetByPlayer[player] or context.Config.Movement.DefaultJumpPreset] or 50
        if math.abs(humanoid.JumpPower - expected) > 0.05 then
            humanoid.JumpPower = expected
        end
    end)

    humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if not humanoid.Parent then return end
        local expected = getExpectedSpeed(player)
        if math.abs(humanoid.WalkSpeed - expected) > 0.05 then
            humanoid.WalkSpeed = expected
        end
    end)
end

local function setSprint(player, enabled)
    if type(enabled) ~= "boolean" then return end
    sprintByPlayer[player] = enabled
    player:SetAttribute("SprintEnabled", enabled)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.WalkSpeed = getExpectedSpeed(player) end
end

local function setJumpPreset(player, preset)
    if type(preset) ~= "string" or not context.Config.Movement.JumpPresets[preset] then return end
    jumpPresetByPlayer[player] = preset
    player:SetAttribute("JumpPreset", preset)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.JumpPower = context.Config.Movement.JumpPresets[preset] end
end

function MovementService.Init(ctx)
    context = ctx
    local function setup(player)
        sprintByPlayer[player] = false
