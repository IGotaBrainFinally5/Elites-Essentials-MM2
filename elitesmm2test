local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local LogService = game:GetService("LogService")
local TextChatService = game:GetService("TextChatService")
local ContentProvider = game:GetService("ContentProvider")

local AdvancedController = {}
AdvancedController.__index = AdvancedController

local function create(className, parent, properties)
    local object = Instance.new(className)
    for key, value in pairs(properties or {}) do object[key] = value end
    object.Parent = parent
    return object
end

local RANKS = { D = true, C = true, B = true, A = true }

function AdvancedController.new(context)
    local self = setmetatable({}, AdvancedController)
    self.Context = context
    self.Config = context.Config
    self.Player = Players.LocalPlayer
    self.LogEntries = {}
    self.MaxLogEntries = 70
    self.RankBillboards = {}
    self.NPCHighlights = {}
    self.Connections = {}
    self.ChatConnection = nil
    self.LastPlayerCount = #Players:GetPlayers()
    self.FrameCount = 0
    self.FrameElapsed = 0
    self.FPS = 0
    self:_buildGui()
    self:_bindDiagnostics()
    self:_bindPlayers()
    self:_bindNPCs()
    self:_preloadAssets()
    self:SetLogVisible(context.Snapshot.Settings and context.Snapshot.Settings.LogConsoleEnabled == true)
    self:SetCameraFilterEnabled(context.Snapshot.Settings and context.Snapshot.Settings.CameraFilterEnabled == true)
    self:SetRankOverlayEnabled(context.Snapshot.Settings and context.Snapshot.Settings.RankOverlayEnabled ~= false)
    self:SetNPCTrackingEnabled(context.Snapshot.Settings and context.Snapshot.Settings.NPCTrackingEnabled == true)
    self:SetChatLoggingEnabled(context.Snapshot.Settings and context.Snapshot.Settings.ChatToLogEnabled == true)
    self:Log("Advanced systems initialized.", "Success")
    return self
end

function AdvancedController:_track(connection)
    table.insert(self.Connections, connection)
    return connection
end

function AdvancedController:_buildGui()
    local playerGui = self.Player:WaitForChild("PlayerGui")
    local old = playerGui:FindFirstChild("ElitesSystemsAdvancedUI")
    if old then old:Destroy() end
    self.Gui = create("ScreenGui", playerGui, {
        Name = "ElitesSystemsAdvancedUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 79,
    })

    self.Vignette = create("Frame", self.Gui, {
        Name = "PurpleVignette", Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1, Visible = false,
    })
    local function edge(name, size, position, rotation)
        local frame = create("Frame", self.Vignette, {
            Name = name, Size = size, Position = position,
            BackgroundColor3 = self.Config.Theme.PurpleDark,
            BorderSizePixel = 0,
        })
        create("UIGradient", frame, {
            Rotation = rotation,
            Color = ColorSequence.new(self.Config.Theme.PurpleDark, self.Config.Theme.Background),
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.12),
                NumberSequenceKeypoint.new(1, 1),
            }),
        })
    end
    edge("Top", UDim2.new(1, 0, 0, 110), UDim2.new(0, 0, 0, 0), 90)
    edge("Bottom", UDim2.new(1, 0, 0, 110), UDim2.new(0, 0, 1, -110), 270)
    edge("Left", UDim2.new(0, 110, 1, 0), UDim2.new(0, 0, 0, 0), 0)
    edge("Right", UDim2.new(0, 110, 1, 0), UDim2.new(1, -110, 0, 0), 180)

    self.Console = create("Frame", self.Gui, {
        Name = "PrivateLogConsole", Size = UDim2.fromOffset(390, 174),
        Position = UDim2.new(0, 16, 1, -190), BackgroundColor3 = self.Config.Theme.Panel,
        BackgroundTransparency = 0.06, BorderSizePixel = 0, Visible = false,
    })
    create("UICorner", self.Console, { CornerRadius = UDim.new(0, 10) })
    create("UIStroke", self.Console, { Color = self.Config.Theme.Purple, Thickness = 1.2 })
    create("TextLabel", self.Console, {
        Name = "Title", Size = UDim2.new(1, -82, 0, 28), Position = UDim2.fromOffset(10, 3),
        BackgroundTransparency = 1, Text = "ELITES SYSTEMS  •  PRIVATE LOG",
        TextColor3 = self.Config.Theme.Text, Font = Enum.Font.GothamBold,
        TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
    })
    local clear = create("TextButton", self.Console, {
        Name = "Clear", Size = UDim2.fromOffset(54, 23), Position = UDim2.new(1, -64, 0, 5),
        BackgroundColor3 = self.Config.Theme.PanelRaised, Text = "CLEAR",
        TextColor3 = self.Config.Theme.Text, Font = Enum.Font.GothamBold, TextSize = 9,
    })
    create("UICorner", clear, { CornerRadius = UDim.new(0, 6) })
    clear.Activated:Connect(function() self:ClearLogs() end)
    self.LogList = create("ScrollingFrame", self.Console, {
        Name = "Entries", Position = UDim2.fromOffset(8, 32), Size = UDim2.new(1, -16, 1, -40),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
        ScrollBarImageColor3 = self.Config.Theme.Purple, AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
    })
    create("UIListLayout", self.LogList, { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder })
    create("UIPadding", self.LogList, { PaddingBottom = UDim.new(0, 4) })
end

function AdvancedController:Log(message, kind)
    local text = tostring(message):gsub("[\r\n]+", " ")
    local record = { Text = text, Kind = kind or "Info", Time = os.date("%H:%M:%S") }
    table.insert(self.LogEntries, record)
    while #self.LogEntries > self.MaxLogEntries do table.remove(self.LogEntries, 1) end
    if not self.LogList or not self.LogList.Parent then return end

    local color = self.Config.Theme.Muted
    if record.Kind == "Error" then color = self.Config.Theme.Red
    elseif record.Kind == "Warning" then color = self.Config.Theme.Gold
    elseif record.Kind == "Success" then color = self.Config.Theme.Green
    elseif record.Kind == "Announcement" then color = self.Config.Theme.Purple end

    local line = create("TextLabel", self.LogList, {
        Size = UDim2.new(1, -6, 0, 18), BackgroundTransparency = 1,
        Text = "[" .. record.Time .. "] " .. text, TextColor3 = color,
        Font = Enum.Font.Code, TextSize = 10, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left, AutomaticSize = Enum.AutomaticSize.Y,
    })
    while #self.LogList:GetChildren() > self.MaxLogEntries + 2 do
        local first = self.LogList:FindFirstChildWhichIsA("TextLabel")
        if not first then break end
        first:Destroy()
    end
    task.defer(function()
        if self.LogList and self.LogList.Parent then
            self.LogList.CanvasPosition = Vector2.new(0, math.max(0, self.LogList.AbsoluteCanvasSize.Y))
        end
    end)
end

function AdvancedController:ClearLogs()
    table.clear(self.LogEntries)
    if self.LogList then
        for _, child in ipairs(self.LogList:GetChildren()) do
            if child:IsA("TextLabel") then child:Destroy() end
        end
    end
    self:Log("Private console cleared.", "Success")
end

function AdvancedController:SetLogVisible(enabled)
    if self.Console then self.Console.Visible = enabled == true end
end

function AdvancedController:SetCameraFilterEnabled(enabled)
    if self.Vignette then self.Vignette.Visible = enabled == true end
end

function AdvancedController:SetChatLoggingEnabled(enabled)
    if enabled and not self.ChatConnection then
        self.ChatConnection = TextChatService.MessageReceived:Connect(function(message)
            if message.Status ~= Enum.TextChatMessageStatus.Success then return end
            local source = message.TextSource
            local speaker = source and (Players:GetPlayerByUserId(source.UserId))
            local name = speaker and speaker.DisplayName or "System"
            self:Log("[CHAT] " .. name .. ": " .. tostring(message.Text), "Info")
        end)
    elseif not enabled and self.ChatConnection then
        self.ChatConnection:Disconnect()
        self.ChatConnection = nil
    end
end

function AdvancedController:_bindDiagnostics()
    self:_track(LogService.MessageOut:Connect(function(message, messageType)
        if messageType == Enum.MessageType.MessageError then
            self:Log("[ERROR] " .. message, "Error")
        elseif messageType == Enum.MessageType.MessageWarning then
            self:Log("[WARNING] " .. message, "Warning")
        end
    end))
    local lastSample = 0
    self:_track(RunService.Heartbeat:Connect(function(dt)
        self.FrameCount += 1
        self.FrameElapsed += dt
        if self.FrameElapsed >= 1 then
            self.FPS = math.floor(self.FrameCount / self.FrameElapsed + 0.5)
            self.FrameCount = 0
            self.FrameElapsed = 0
            if os.clock() - lastSample >= 15 then
                lastSample = os.clock()
                -- Keep this quiet; the value is available to other UI elements if needed.
            end
        end
    end))
    local function observeLocalCharacter(character)
        local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 8)
        if not humanoid then return end
        self:_track(humanoid.StateChanged:Connect(function(oldState, newState)
            if newState == Enum.HumanoidStateType.Freefall or newState == Enum.HumanoidStateType.Landed
                or newState == Enum.HumanoidStateType.FallingDown then
                self.LastHumanoidState = newState.Name
            end
        end))
    end
    if self.Player.Character then task.spawn(observeLocalCharacter, self.Player.Character) end
    self:_track(self.Player.CharacterAdded:Connect(observeLocalCharacter))
    self:_track(Players.PlayerAdded:Connect(function(player)
        self:Log(player.DisplayName .. " joined the server.", "Info")
    end))
    self:_track(Players.PlayerRemoving:Connect(function(player)
        self:Log(player.DisplayName .. " left the server.", "Info")
    end))
end

function AdvancedController:_rankFor(player)
    local rank = player:GetAttribute("Rank")
    if type(rank) ~= "string" then return nil end
    rank = string.upper(rank)
    return RANKS[rank] and rank or nil
end

function AdvancedController:_refreshRank(player)
    local old = self.RankBillboards[player]
    if old then old:Destroy(); self.RankBillboards[player] = nil end
    if not self.RankOverlayEnabled then return end
    local character = player.Character
    local head = character and (character:FindFirstChild("Head") or character:WaitForChild("Head", 5))
    local rank = self:_rankFor(player)
    if not head or not rank then return end
    local board = create("BillboardGui", character, {
        Name = "ElitesRankOverlay", Adornee = head,
        Size = UDim2.fromOffset(130, 25), StudsOffset = Vector3.new(0, 2.8, 0),
        AlwaysOnTop = false,
    })
    local label = create("TextLabel", board, {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = self.Config.Theme.Panel,
        BackgroundTransparency = 0.12, Text = rank .. "  •  " .. tostring(player:GetAttribute("DisplayAlias") or player.DisplayName),
        TextColor3 = self.Config.Theme.Text, Font = Enum.Font.GothamBold, TextSize = 12,
    })
    create("UICorner", label, { CornerRadius = UDim.new(0, 6) })
    create("UIStroke", label, { Color = self.Config.Theme.Purple, Thickness = 1 })
    self.RankBillboards[player] = board
end

function AdvancedController:SetRankOverlayEnabled(enabled)
    self.RankOverlayEnabled = enabled == true
    for _, player in ipairs(Players:GetPlayers()) do self:_refreshRank(player) end
end

function AdvancedController:_bindPlayers()
    local function bind(player)
        local function bindCharacter(character)
            task.defer(function()
                if character.Parent then self:_refreshRank(player) end
            end)
        end
        self:_track(player.CharacterAdded:Connect(bindCharacter))
        self:_track(player:GetAttributeChangedSignal("Rank"):Connect(function() self:_refreshRank(player) end))
        self:_track(player:GetAttributeChangedSignal("DisplayAlias"):Connect(function() self:_refreshRank(player) end))
        if player.Character then bindCharacter(player.Character) end
    end
    for _, player in ipairs(Players:GetPlayers()) do bind(player) end
    self:_track(Players.PlayerAdded:Connect(bind))
    self:_track(Players.PlayerRemoving:Connect(function(player)
        local board = self.RankBillboards[player]
        if board then board:Destroy() end
        self.RankBillboards[player] = nil
    end))
end

function AdvancedController:_npcModel(instance)
    if instance:IsA("Model") then return instance end
    return instance:FindFirstAncestorOfClass("Model")
end

function AdvancedController:_refreshNPC(instance)
    local model = self:_npcModel(instance)
    if not model or self.NPCHighlights[model] or not self.NPCTrackingEnabled then return end
    local highlight = create("Highlight", model, {
        Name = "ElitesEntityTracker", Adornee = model,
        DepthMode = Enum.HighlightDepthMode.Occluded,
        FillColor = self.Config.Theme.Purple, OutlineColor = self.Config.Theme.Purple,
        FillTransparency = 0.9, OutlineTransparency = 0.1,
    })
    self.NPCHighlights[model] = highlight
end

function AdvancedController:SetNPCTrackingEnabled(enabled)
    self.NPCTrackingEnabled = enabled == true
    if self.NPCTrackingEnabled then
        for _, instance in ipairs(CollectionService:GetTagged(self.Config.NPCTag)) do self:_refreshNPC(instance) end
    else
        for model, highlight in pairs(self.NPCHighlights) do
            if highlight then highlight:Destroy() end
            self.NPCHighlights[model] = nil
        end
    end
end

function AdvancedController:_bindNPCs()
    self:_track(CollectionService:GetInstanceAddedSignal(self.Config.NPCTag):Connect(function(instance)
        self:_refreshNPC(instance)
    end))
    self:_track(CollectionService:GetInstanceRemovedSignal(self.Config.NPCTag):Connect(function(instance)
        local model = self:_npcModel(instance)
        local highlight = model and self.NPCHighlights[model]
        if highlight then highlight:Destroy(); self.NPCHighlights[model] = nil end
    end))
end

function AdvancedController:_preloadAssets()
    local root = game:GetService("ReplicatedStorage"):WaitForChild("ElitesSystems")
    local folder = root:FindFirstChild(self.Config.AssetFolderName or "Assets")
    if not folder then return end
    local supported = {
        Sound = true, Decal = true, Texture = true, ImageLabel = true, ImageButton = true,
        MeshPart = true, SpecialMesh = true, ParticleEmitter = true, Beam = true, Trail = true,
        Animation = true,
    }
    local assets = {}
    for _, instance in ipairs(folder:GetDescendants()) do
        if supported[instance.ClassName] then table.insert(assets, instance) end
    end
    if #assets == 0 then return end
    task.spawn(function()
        local ok, err = pcall(function() ContentProvider:PreloadAsync(assets) end)
        if ok then self:Log("Approved asset preload completed (" .. tostring(#assets) .. " instances).", "Success")
        else self:Log("Asset preload failed: " .. tostring(err), "Warning") end
    end)
end

function AdvancedController:HandleEvent(eventName, payload)
    payload = type(payload) == "table" and payload or {}
    if eventName == "Announcement" then
        self:Log("[ANNOUNCEMENT] " .. tostring(payload.Message or "Game announcement"), "Announcement")
    elseif eventName == "KillFeed" then
        self:Log(tostring(payload.Killer or "Unknown") .. " eliminated " .. tostring(payload.Victim or "Unknown"), "Success")
    end
end

function AdvancedController:Destroy()
    if self.ChatConnection then self.ChatConnection:Disconnect(); self.ChatConnection = nil end
    for _, connection in ipairs(self.Connections) do
        if connection and connection.Connected then connection:Disconnect() end
    end
    table.clear(self.Connections)
    for player, board in pairs(self.RankBillboards) do if board then board:Destroy() end end
    for model, highlight in pairs(self.NPCHighlights) do if highlight then highlight:Destroy() end end
    if self.Gui then self.Gui:Destroy() end
end

return AdvancedController

