--[[
ELITES SYSTEMS v0.2.0 - ONE-FILE STUDIO INSTALLER

HOW TO USE:
1. Open your own Roblox experience in Roblox Studio (edit mode, not Play mode).
2. Open the Command Bar (View > Command Bar, or Ctrl+9 on Windows).
3. Paste this entire file into the Command Bar and run it once.
4. The installer creates the required server, shared, and client scripts.
5. Press Play to test. See comments in Config for customization.

IMPORTANT:
- This is a Studio Command Bar installer, NOT a Script/LocalScript to insert into the game.
- Roblox separates server and client execution for security. This one file installs the
  required Scripts/LocalScripts/ModuleScripts into their proper services automatically.
- Existing folders named "ElitesSystems" in the three target locations are replaced.
  Back up any edits you made inside those folders before running this installer.
- No loadstring, executor, or external code download is used.
]]

local DESTINATIONS = {
    { Service = game:GetService("ReplicatedStorage"), Label = "ReplicatedStorage" },
    { Service = game:GetService("ServerScriptService"), Label = "ServerScriptService" },
    { Service = game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts"), Label = "StarterPlayer.StarterPlayerScripts" },
}

local ROOT_NAME = "ElitesSystems"
local installedCount = 0

-- Replace only this project's exact root folders in the known target locations.
for _, destination in ipairs(DESTINATIONS) do
    local existing = destination.Service:FindFirstChild(ROOT_NAME)
    if existing then
        existing:Destroy()
        print("[Elites Systems] Replaced existing folder in " .. destination.Label)
    end
end

local function getOrCreateFolder(parent, name)
    local folder = parent:FindFirstChild(name)
    if folder and not folder:IsA("Folder") then
        folder:Destroy()
        folder = nil
    end
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = name
        folder.Parent = parent
    end
    return folder
end

local function resolveService(serviceName)
    if serviceName == "StarterPlayer" then
        return game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts")
    end
    return game:GetService(serviceName)
end

local function installEntry(entry)
    local parent = resolveService(entry.Service)
    for _, folderName in ipairs(entry.Folders) do
        parent = getOrCreateFolder(parent, folderName)
    end

    local old = parent:FindFirstChild(entry.Name)
    if old then old:Destroy() end

    local object = Instance.new(entry.ClassName)
    object.Name = entry.Name
    if object:IsA("LuaSourceContainer") then
        object.Source = entry.Source or ""
    end
    if object:IsA("BaseScript") then
        object.Disabled = false
    end
    object.Parent = parent
    installedCount += 1
end

