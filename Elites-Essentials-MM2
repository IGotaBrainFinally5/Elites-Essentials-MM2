	if n and n >= 0.1 and n <= 3 then
		Config.SEARCH_INTERVAL = n
		intervalLabel.Text = "Search Interval: " .. n .. "s"
		log("Interval set to " .. n)
	else
		intervalBox.Text = tostring(Config.SEARCH_INTERVAL)
	end
end)

local function bindColorBox(box, key)
	box.FocusLost:Connect(function()
		local col = parseColor(box.Text)
		if col then
			Colors[key] = col
			applyColors()
			log("Color updated: " .. key)
		end
	end)
end
bindColorBox(bgBox, "Background")
bindColorBox(accentBox, "Accent")
bindColorBox(textBoxC, "Text")

