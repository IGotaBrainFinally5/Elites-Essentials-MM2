local Players = game:GetService("Players")

local AnnouncementService = {}
local context
local lastRequest = {}

local function isAdmin(player)
    return table.find(context.Config.AdminUserIds, player.UserId) ~= nil
end

function AnnouncementService.Init(ctx)
    context = ctx
    context.Remotes.Action.OnServerEvent:Connect(function(player, action)
        if action ~= "RequestAnnouncement" then return end
        if not isAdmin(player) then
            context.Notify(player, "You are not authorized to broadcast announcements.", "Warning")
            return
        end
        local now = os.clock()
        if now - (lastRequest[player] or 0) < 10 then return end
        lastRequest[player] = now
        context.Remotes.Push:FireAllClients("Announcement", {
            Message = "A developer test announcement was broadcast.",
            From = player.DisplayName,
        })
    end)
    Players.PlayerRemoving:Connect(function(player) lastRequest[player] = nil end)
end

return AnnouncementService

