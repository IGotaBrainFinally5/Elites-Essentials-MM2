    function Window:AddTab(opts)
        opts = opts or {}
        local tab = { Name = opts.Name or "Tab", _order = 0 }

        tab.Button = new("TextButton", {
            Name = tab.Name .. "Tab", AutoButtonColor = false, Text = "",
            BackgroundColor3 = T.Blue, BackgroundTransparency = 1,
