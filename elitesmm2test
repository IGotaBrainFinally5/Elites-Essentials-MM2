function UIController:SaveSetting(key, value)
    self.Settings[key] = value
    self.Context.Remotes.Action:FireServer("SavePreference", { Key = key, Value = value })
    self:ApplySettings()
end

function UIController:ApplySettings()
    if self.Context.Camera then
        self.Context.Camera:SetRecoilEnabled(self.Settings.RecoilEnabled)
        self.Context.Camera:SetBreatherEnabled(self.Settings.AimBreatherEnabled)
    end
    if self.Context.Movement then
        self.Context.Movement:SetBoulderAssist(self.Settings.BoulderAssistEnabled)
    end
    if self.Context.Visuals then
        self.Context.Visuals:SetFrames(self.Settings.PlayerFramesEnabled)
        self.Context.Visuals:SetStats(self.Settings.StatViewerEnabled)
        self.Context.Visuals:SetIdentity(self.Settings.IdentityEnabled == true)
    end
    if self.Crosshair then self.Crosshair.Visible = self.Settings.CrosshairEnabled end
    if self.Context.Advanced then
        self.Context.Advanced:SetCameraFilterEnabled(self.Settings.CameraFilterEnabled)
        self.Context.Advanced:SetLogVisible(self.Settings.LogConsoleEnabled)
        self.Context.Advanced:SetChatLoggingEnabled(self.Settings.ChatToLogEnabled)
        self.Context.Advanced:SetRankOverlayEnabled(self.Settings.RankOverlayEnabled)
        self.Context.Advanced:SetNPCTrackingEnabled(self.Settings.NPCTrackingEnabled)
    end
    if self.Radar then
        self.Radar.Visible = self.Settings.RadarEnabled and self.Snapshot.RoleInspectionAllowed == true
    end
end

function UIController:MakeSection(text)
    return create("TextLabel", self.Content, {
        Size = UDim2.new(1, -4, 0, 24), BackgroundTransparency = 1,
        Text = text:upper(), TextColor3 = self.Theme.Purple,
        Font = Enum.Font.GothamBlack, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
    })
end

function UIController:MakeInfo(text)
    return create("TextLabel", self.Content, {
        Size = UDim2.new(1, -4, 0, 46), BackgroundColor3 = self.Theme.Panel,
        Text = text, TextColor3 = self.Theme.Muted, Font = Enum.Font.Gotham,
