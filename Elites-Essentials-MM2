------------------------------------------------------------------
-- helpers
------------------------------------------------------------------
local function isCollectible(part)
    if not part:IsA("BasePart") then return false end
    if part:IsDescendantOf(player.Character or workspace) and part:IsDescendantOf(player.Character or workspace) then
        -- skip anything parented under our own character
        local char = player.Character
        if char and part:IsDescendantOf(char) then return false end
    end
    local lower = part.Name:lower()
    for _, needle in ipairs(CONFIG.matchNames) do
        if lower:find(needle, 1, true) then return true end
    end
    return false
end

local function findCollectibles()
    local list = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isCollectible(obj) then
            table.insert(list, obj)
        end
    end
    return list
end

local function getHRP()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function resetCharacter()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.Health = 0 end
end

------------------------------------------------------------------
-- farm loop
------------------------------------------------------------------
local function collectAll()
    local hrp = getHRP()
    if not hrp then return 0 end

    local items = findCollectibles()
    if #items == 0 then return 0 end

    local count = 0
    for _, item in ipairs(items) do
        if not enabled then break end
        if item and item.Parent and item:IsA("BasePart") then
            hrp.CFrame = item.CFrame + Vector3.new(0, CONFIG.verticalOffset, 0)
            count += 1
            status.Text = string.format("collected %d  |  last: %s", count, item.Name)
            task.wait(CONFIG.collectDelay)
        end
    end
    return count
end

local function farmLoop()
    noCoinTimer = 0
    while enabled do
        local got = collectAll()
        if got > 0 then
            noCoinTimer = 0
        else
            noCoinTimer += CONFIG.scanInterval
            local left = math.max(0, CONFIG.noCoinReset - noCoinTimer)
            status.Text = string.format("nothing collectible — reset in %.1fs", left)
            if noCoinTimer >= CONFIG.noCoinReset then
                status.Text = "resetting..."
                resetCharacter()
                noCoinTimer = 0
                task.wait(2) -- give the game time to respawn / load next round
            end
        end
        task.wait(CONFIG.scanInterval)
    end
end

local function startFarm()
    if enabled then return end
    enabled = true
    toggle.Text = "ON"
    toggle.BackgroundColor3 = Color3.fromRGB(45, 190, 70)
    status.Text = "running..."
    farmThread = task.spawn(farmLoop)
end

local function stopFarm()
    enabled = false
    toggle.Text = "OFF"
    toggle.BackgroundColor3 = Color3.fromRGB(190, 50, 50)
    status.Text = "idle"
end

toggle.MouseButton1Click:Connect(function()
    if enabled then stopFarm() else startFarm() end
end)

resetBtn.MouseButton1Click:Connect(resetCharacter)

-- character swaps (death, respawn, new round) need no re-hook:
-- the loop reads player.Character fresh on every scan.
