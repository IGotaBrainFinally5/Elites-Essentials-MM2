local function numberInputRow(parent, labelText, initial, minV, maxV, onChange)
    local row = card(parent, 56)
    local lbl = label(row, labelText, 20, State.theme.text, false)
    lbl.Position = UDim2.new(0, 12, 0.5, -10)
    lbl.Size = UDim2.new(1, -120, 0, 20)

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 90, 0, 34)
    box.Position = UDim2.new(1, -102, 0.5, -17)
    box.BackgroundColor3 = State.theme.bg
    box.Text = tostring(initial)
    box.TextColor3 = State.theme.text
    box.PlaceholderText = "0"
    box.Font = Enum.Font.Gotham
    box.TextSize = 14
    box.ClearTextOnFocus = false
    box.Parent = row
    corner(box, 8)
    stroke(box, State.theme.stroke, 1)

    local value = initial
    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then
            n = math.clamp(math.floor(n), minV, maxV)
            value = n
            box.Text = tostring(n)
            if onChange then onChange(n) end
        else
            box.Text = tostring(value)
        end
    end)

    return row, function() return value end
end

-- ============================================================
-- FACTORY: Dropdown (for theme)
-- ============================================================
local function dropdownRow(parent, labelText, options, initial, onChange)
    local row = card(parent, 56)
    local lbl = label(row, labelText, 20, State.theme.text, false)
    lbl.Position = UDim2.new(0, 12, 0.5, -10)
    lbl.Size = UDim2.new(1, -140, 0, 20)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 110, 0, 34)
    btn.Position = UDim2.new(1, -122, 0.5, -17)
    btn.BackgroundColor3 = State.theme.bg
    btn.Text = initial
    btn.TextColor3 = State.theme.text
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.AutoButtonColor = true
    btn.Parent = row
    corner(btn, 8)
    stroke(btn, State.theme.stroke, 1)

    local open = false
    local menu

    local function buildMenu()
        if menu then menu:Destroy() end
        menu = Instance.new("Frame")
        menu.Size = UDim2.new(0, 110, 0, #options * 34 + 8)
        menu.Position = UDim2.new(1, -122, 1, 4)
        menu.BackgroundColor3 = State.theme.card
        menu.BorderSizePixel = 0
        menu.ZIndex = 20
        menu.Parent = btn
        corner(menu, 8)
        stroke(menu, State.theme.stroke, 1)

        local ml = Instance.new("UIListLayout")
        ml.Padding = UDim.new(0, 2)
        ml.SortOrder = Enum.SortOrder.LayoutOrder
        ml.Parent = menu

        local mp = Instance.new("UIPadding")
        mp.PaddingTop = UDim.new(0, 4)
        mp.PaddingBottom = UDim.new(0, 4)
        mp.PaddingLeft = UDim.new(0, 4)
        mp.PaddingRight = UDim.new(0, 4)
        mp.Parent = menu

        for i, opt in ipairs(options) do
            local item = Instance.new("TextButton")
            item.Size = UDim2.new(1, 0, 0, 32)
            item.BackgroundColor3 = State.theme.bg
            item.Text = opt
            item.TextColor3 = State.theme.text
            item.Font = Enum.Font.Gotham
            item.TextSize = 13
            item.ZIndex = 21
            item.LayoutOrder = i
            item.Parent = menu
            corner(item, 6)

            item.MouseButton1Click:Connect(function()
                btn.Text = opt
                if onChange then onChange(opt) end
                open = false
                menu:Destroy()
                menu = nil
            end)
        end
    end

    btn.MouseButton1Click:Connect(function()
        open = not open
        if open then buildMenu() elseif menu then menu:Destroy() menu = nil end
    end)

    return row
end

