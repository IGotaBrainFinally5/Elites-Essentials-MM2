local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local root = ReplicatedStorage:WaitForChild("ElitesSystems")
local shared = root:WaitForChild("Shared")
local Config = require(shared:WaitForChild("Config"))
local Localization = require(shared:WaitForChild("Localization"))
local ConnectionManager = require(shared:WaitForChild("ConnectionManager"))

local remotesFolder = ReplicatedStorage:WaitForChild(Config.RemoteFolderName)
local Remotes = {
    Action = remotesFolder:WaitForChild("Action"),
    Push = remotesFolder:WaitForChild("Push"),
    RequestSnapshot = remotesFolder:WaitForChild("RequestSnapshot"),
}

-- Wait briefly for the server's saved profile to finish loading before requesting settings.
local loadDeadline = os.clock() + 10
while player:GetAttribute("DataLoaded") ~= true and os.clock() < loadDeadline do
    task.wait(0.1)
end

local snapshot = {}
local ok, result = pcall(function()
    return Remotes.RequestSnapshot:InvokeServer()
end)
if ok and type(result) == "table" then
    snapshot = result
else
    warn("[ElitesSystems] Could not fetch initial server snapshot:", result)
    snapshot = { Stats = {}, Settings = {}, RoleInspectionAllowed = false, Roles = {} }
end

local controllersFolder = script.Parent:WaitForChild("Controllers")
local function safeRequire(moduleName)
    local module = controllersFolder:FindFirstChild(moduleName)
    if not module then error("Missing controller: " .. moduleName) end
    local success, result = pcall(require, module)
    if not success then
        warn("[ElitesSystems] Controller failed to load: " .. moduleName .. " / " .. tostring(result))
        error(result)
    end
    return result
end

local CameraController = safeRequire("CameraController")
local MovementController = safeRequire("MovementController")
local VisualController = safeRequire("VisualController")
local UIController = safeRequire("UIController")
local AdvancedController = safeRequire("AdvancedController")

local advanced = AdvancedController.new({ Config = Config, Snapshot = snapshot, Remotes = Remotes })
local camera = CameraController.new()
local movement = MovementController.new(Config)
local visuals = VisualController.new(player)
visuals:SetRoleSnapshot({
    RoleInspectionAllowed = snapshot.RoleInspectionAllowed,
    Roles = snapshot.Roles or {},
})

local context = {
    Config = Config,
    Localization = Localization,
    ConnectionManager = ConnectionManager,
    Remotes = Remotes,
    Snapshot = snapshot,
    Camera = camera,
    Movement = movement,
    Visuals = visuals,
    Advanced = advanced,
}
local ui = UIController.new(context)

Remotes.Push.OnClientEvent:Connect(function(eventName, payload)
    if type(payload) ~= "table" then payload = {} end
    if eventName == "Notification" then
        ui:Notify(payload.Message or "Notification", payload.Kind)
    elseif eventName == "WeaponFired" then
        camera:OnShot()
    elseif eventName == "HitConfirmed" then
        ui:UpdateHit(payload)
    elseif eventName == "RoleSnapshot" then
        ui:SetRoleSnapshot(payload)
    elseif eventName == "OwnRole" then
        ui:SetOwnRole(payload.Role)
    elseif eventName == "Announcement" or eventName == "KillFeed" then
        advanced:HandleEvent(eventName, payload)
    end
end)

player.CharacterAdded:Connect(function()
    task.wait(0.5)
    ui:Notify("Character ready.", "Info")
end)

print("[ElitesSystems] Client started. UI: RightShift to toggle.")

