local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local RoleService = {}
local context
local roles = {}
local roundActive = false

local function isAdmin(player)
    if not player then return false end
    if player:GetAttribute("CanInspectRoles") == true then return true end
    if RunService:IsStudio() and context.Config.AllowRoleInspectionInStudio then return true end
    for _, userId in ipairs(context.Config.AdminUserIds) do
        if userId ~= 0 and player.UserId == userId then return true end
    end
    return false
end

function RoleService.CanInspect(player)
    return isAdmin(player)
end

function RoleService.GetRole(player)
    return player and roles[player.UserId] or nil
end

function RoleService.SetRole(player, role)
    if not player or not table.find(context.Config.Roles, role) then return false end
    roles[player.UserId] = role
    RoleService.BroadcastInspectorSnapshots()
    return true
end

function RoleService.GetSnapshot(viewer)
    local result = {
        RoleInspectionAllowed = isAdmin(viewer),
        OwnRole = roles[viewer.UserId],
        Roles = {},
    }
    if result.RoleInspectionAllowed then
        for userId, role in pairs(roles) do
            result.Roles[tostring(userId)] = role
        end
    end
    return result
end

function RoleService.BroadcastInspectorSnapshots()
    for _, player in ipairs(Players:GetPlayers()) do
        if isAdmin(player) then
            context.Remotes.Push:FireClient(player, "RoleSnapshot", RoleService.GetSnapshot(player))
        end
    end
end

function RoleService.AssignTestRoles()
    local list = Players:GetPlayers()
    if #list < 2 then return end
    -- This is a basic round-test assignment. Replace it with your own round manager as needed.
    local shuffled = table.clone(list)
    for index = #shuffled, 2, -1 do
        local swapIndex = math.random(1, index)
        shuffled[index], shuffled[swapIndex] = shuffled[swapIndex], shuffled[index]
    end
    for index, player in ipairs(shuffled) do
        player:SetAttribute("WitnessedEvent", false)
        if index == 1 then
            roles[player.UserId] = "Murderer"
        elseif index == 2 then
            roles[player.UserId] = "Sheriff"
        else
            roles[player.UserId] = "Innocent"
        end
    end
    roundActive = true
    RoleService.BroadcastInspectorSnapshots()
    for _, player in ipairs(list) do
        context.Remotes.Push:FireClient(player, "OwnRole", { Role = roles[player.UserId] })
        context.Notify(player, "Your test-round role has been assigned.", "Info")
    end
end

function RoleService.MarkWitnesses(position, excludedPlayer)
    if typeof(position) ~= "Vector3" then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= excludedPlayer then
            local character = player.Character
            local head = character and character:FindFirstChild("Head")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if head and humanoid and humanoid.Health > 0 then
                local offset = position - head.Position
                if offset.Magnitude <= context.Config.WitnessDistance then
                    local params = RaycastParams.new()
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    params.FilterDescendantsInstances = { character }
                    local obstruction = Workspace:Raycast(head.Position, offset, params)
                    -- A ray that reaches the victim near the event position still counts as line of sight.
                    local clearPath = not obstruction or (obstruction.Position - position).Magnitude <= 4
                    if clearPath then
                        player:SetAttribute("WitnessedEvent", true)
                        context.Notify(player, "You witnessed a combat event.", "Warning")
                    end
                end
            end
        end
    end
end

function RoleService.Init(ctx)
    context = ctx
    Players.PlayerAdded:Connect(function(player)
        roles[player.UserId] = "Innocent"
        if context.Config.AutoAssignTestRoles then
            task.delay(4, function()
                if not roundActive and #Players:GetPlayers() >= 2 then
                    RoleService.AssignTestRoles()
                end
            end)
        end
    end)
    Players.PlayerRemoving:Connect(function(player)
        roles[player.UserId] = nil
        -- PlayerRemoving fires before the departing player is fully removed.
        if #Players:GetPlayers() <= 3 then
            roundActive = false
            task.delay(1, function()
                if context.Config.AutoAssignTestRoles and not roundActive and #Players:GetPlayers() >= 2 then
                    RoleService.AssignTestRoles()
                end
            end)
        end
        RoleService.BroadcastInspectorSnapshots()
    end)
    for _, player in ipairs(Players:GetPlayers()) do
        roles[player.UserId] = roles[player.UserId] or "Innocent"
    end
    if context.Config.AutoAssignTestRoles and #Players:GetPlayers() >= 2 then
        task.delay(4, function()
            if not roundActive and #Players:GetPlayers() >= 2 then
                RoleService.AssignTestRoles()
            end
        end)
    end
end

return RoleService

