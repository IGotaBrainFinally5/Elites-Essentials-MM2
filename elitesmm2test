-- Connection manager used by client controllers to track/disconnect event listeners.
-- Callback failures are reported instead of silently killing a controller's event flow.
local ConnectionManager = {}
ConnectionManager.__index = ConnectionManager

function ConnectionManager.new(label)
    return setmetatable({ Label = label or "ConnectionManager", Connections = {} }, ConnectionManager)
end

function ConnectionManager:Connect(signal, callback)
    assert(signal and typeof(callback) == "function", "Connect expects a signal and callback")
    local connection = signal:Connect(function(...)
        local arguments = table.pack(...)
        local ok, err = pcall(function()
            callback(table.unpack(arguments, 1, arguments.n))
        end)
        if not ok then
            warn(string.format("[ElitesSystems:%s] Event callback failed: %s", self.Label, tostring(err)))
        end
    end)
    table.insert(self.Connections, connection)
    return connection
end

function ConnectionManager:Track(connection)
    if connection then table.insert(self.Connections, connection) end
    return connection
end

function ConnectionManager:DisconnectAll()
    for index = #self.Connections, 1, -1 do
        local connection = self.Connections[index]
        if connection and connection.Connected then
            connection:Disconnect()
        end
        self.Connections[index] = nil
    end
end

return ConnectionManager

