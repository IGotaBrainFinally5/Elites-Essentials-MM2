local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local MovementController = {}
MovementController.__index = MovementController

local function hasBoulderTag(instance, tag)
    local cursor = instance
    while cursor and cursor ~= workspace do
        if CollectionService:HasTag(cursor, tag) then return true end
        cursor = cursor.Parent
    end
    return false
end

function MovementController.new(config)
    local self = setmetatable({}, MovementController)
    self.Config = config
    self.Player = Players.LocalPlayer
    self.BoulderAssistEnabled = false
    self.LastJump = 0

    RunService.Heartbeat:Connect(function()
        if not self.BoulderAssistEnabled then return end
        local character = self.Player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not root or humanoid.Health <= 0 then return end
        if humanoid.FloorMaterial == Enum.Material.Air or humanoid.MoveDirection.Magnitude < 0.15 then return end
        if os.clock() - self.LastJump < 1.1 then return end

        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { character }
        local hit = workspace:Raycast(root.Position + Vector3.new(0, 1.2, 0), humanoid.MoveDirection.Unit * 5, params)
        if hit and hasBoulderTag(hit.Instance, self.Config.BoulderTag) then
            humanoid.Jump = true
            self.LastJump = os.clock()
        end
    end)
    return self
end

function MovementController:SetBoulderAssist(enabled)
    self.BoulderAssistEnabled = enabled == true
end

return MovementController

