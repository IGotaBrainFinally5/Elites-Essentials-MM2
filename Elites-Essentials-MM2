-- ============================================================
-- FACTORY: Slider row
-- ============================================================
local function sliderRow(parent, labelText, minV, maxV, initial, step, onChange)
    local row = card(parent, 72)
    local lbl = label(row, labelText, 20, State.theme.text, false)
    lbl.Position = UDim2.new(0, 12, 0, 8)
    lbl.Size = UDim2.new(1, -100, 0, 18)

    local valueLbl = Instance.new("TextLabel")
    valueLbl.Size = UDim2.new(0, 80, 0, 18)
    valueLbl.Position = UDim2.new(1, -92, 0, 8)
    valueLbl.BackgroundTransparency = 1
    valueLbl.Text = tostring(initial)
    valueLbl.TextColor3 = State.theme.accent
    valueLbl.Font = Enum.Font.GothamBold
    valueLbl.TextSize = 13
    valueLbl.TextXAlignment = Enum.TextXAlignment.Right
    valueLbl.Parent = row

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -24, 0, 8)
    track.Position = UDim2.new(0, 12, 0, 42)
    track.BackgroundColor3 = State.theme.bg
    track.BorderSizePixel = 0
    track.Parent = row
    corner(track, 4)

    local fill = Instance.new("Frame")
    local pct = (initial - minV) / (maxV - minV)
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = State.theme.accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    corner(fill, 4)

    local knob = Instance.new("TextButton")
    knob.Size = UDim2.new(0, 24, 0, 24)
    knob.Position = UDim2.new(pct, -12, 0.5, -12)
    knob.BackgroundColor3 = State.theme.text
    knob.Text = ""
    knob.AutoButtonColor = false
    knob.Parent = track
    corner(knob, 12)

    local value = initial
    local function snap(v)
        v = math.clamp(v, minV, maxV)
        if step and step > 0 then
            v = math.floor((v / step) + 0.5) * step
        end
        return v
    end

    local function applyFromX(x)
        local abs = track.AbsolutePosition.X
        local width = track.AbsoluteSize.X
        if width <= 0 then return end
        local p = math.clamp((x - abs) / width, 0, 1)
        local v = snap(minV + p * (maxV - minV))
        value = v
        local np = (v - minV) / (maxV - minV)
        fill.Size = UDim2.new(np, 0, 1, 0)
        knob.Position = UDim2.new(np, -12, 0.5, -12)
        valueLbl.Text = tostring(v)
        if onChange then onChange(v) end
    end

    local dragging = false
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or
           input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or
           input.UserInputType == Enum.UserInputType.MouseButton1 then
            applyFromX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.Touch or
           input.UserInputType == Enum.UserInputType.MouseMovement then
            applyFromX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or
           input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    return row, function() return value end, function() valueLbl.Text = tostring(value) end
end

