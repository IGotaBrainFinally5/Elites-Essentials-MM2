    log("ERR", "parent to PlayerGui failed: " .. tostring(parentErr))
    local cgOk, cg = pcall(function() return game:GetService("CoreGui") end)
    if cgOk and cg then
        local fbOk, fbErr = pcall(function() gui.Parent = cg end)
        if fbOk then
            log("WARN", "fell back to CoreGui successfully")
        else
            log("ERR", "CoreGui fallback failed: " .. tostring(fbErr))
            return
        end
    else
        log("ERR", "no fallback parent")
        return
    end
else
    log("INFO", "gui.Parent = " .. gui.Parent:GetFullName())
end

------------------------------------------------------------------
-- 8. verify parent + size
------------------------------------------------------------------
task.wait(0.35)

local problems = {}
if not gui or not gui.Parent then
    table.insert(problems, "ScreenGui has no parent")
end
if gui and not gui.Enabled then
    table.insert(problems, "ScreenGui.Enabled is false")
end
if gui and (gui.AbsoluteSize.X <= 0 or gui.AbsoluteSize.Y <= 0) then
    table.insert(problems, string.format(
        "ScreenGui.AbsoluteSize = %s", tostring(gui.AbsoluteSize)))
end
if frame and (frame.AbsoluteSize.X <= 0 or frame.AbsoluteSize.Y <= 0) then
    table.insert(problems, string.format(
        "Root.AbsoluteSize = %s", tostring(frame.AbsoluteSize)))
end

if #problems > 0 then
    for _, p in ipairs(problems) do
        log("ERR", "verification: " .. p)
    end
    if errorBanner and errorBanner.Parent then
        errorBanner.Visible = true
        errorBanner.Text = "UI issues:\n" .. table.concat(problems, "\n")
    end
else
    log("INFO", "verification passed: parented, enabled, non-zero size")
end

------------------------------------------------------------------
-- 9. watchdog — re-parent if game clears PlayerGui
------------------------------------------------------------------
gui.AncestryChanged:Connect(function(_, newParent)
    if intentionalClose then return end
    if newParent ~= nil then return end
    if gui.Parent ~= nil then return end

    log("WARN", "ScreenGui unparented — likely game cleared PlayerGui")

    task.defer(function()
        if gui.Parent ~= nil then return end
        local ok, err = pcall(function()
            gui.Parent = playerGui
        end)
        if ok then
            log("INFO", "re-parented successfully")
        else
            log("ERR", "re-parent failed: " .. tostring(err))
        end
    end)
end)

------------------------------------------------------------------
-- 10. periodic parent check (belt and suspenders)
------------------------------------------------------------------
task.spawn(function()
    while gui and gui.Parent ~= nil or (gui and not intentionalClose) do
        task.wait(2)
        if intentionalClose then break end
        if not gui or not gui.Parent then
            if gui and not intentionalClose then
                pcall(function() gui.Parent = playerGui end)
            end
        end
    end
end)

log("INFO", "MM2 Auto Farm loaded — tap ON to arm the collector")
