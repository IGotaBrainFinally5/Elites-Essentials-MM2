FeatureModules = {}

local CoinFarmRuntime = {
    running     = false,
    paused      = false,
    task        = nil,
    generation  = 0,
    currentTarget = nil,
    collected   = 0,
    session     = 0,
    lastStatus  = "idle",
    statusLabel = nil,
}

local function getCharacter()
    local char = LocalPlayer and LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then
        return char, hrp, hum
    end
    return nil
end

local function isValidCoin(obj)
    if not obj or not obj.Parent then return false end
    if obj:IsA("BasePart") then return true end
    if obj:IsA("Model") then
        return obj.PrimaryPart ~= nil or obj:FindFirstChildWhichIsA("BasePart") ~= nil
    end
    return false
end

local function getCoinPosition(obj)
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local p = obj:FindFirstChildWhichIsA("BasePart")
        if p then return p.Position end
    end
    return nil
end

local function findAllCoins()
    local list = {}

    pcall(function()
        for _, obj in ipairs(CollectionService:GetTagged(Config.CoinTag)) do
            if isValidCoin(obj) then
                list[#list + 1] = obj
            end
        end
    end)

    local folder = workspace:FindFirstChild(Config.CoinFolderName)
    if folder then
        for _, obj in ipairs(folder:GetDescendants()) do
            if isValidCoin(obj) and (obj:IsA("BasePart") or obj:IsA("Model")) then
                local already = false
                for _, existing in ipairs(list) do
                    if existing == obj then already = true break end
                end
                if not already then list[#list + 1] = obj end
            end
        end
    end

    if #list == 0 then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if (obj:IsA("BasePart") or obj:IsA("Model"))
                and string.find(string.lower(obj.Name), string.lower(Config.CoinNameMatch), 1, true)
                and isValidCoin(obj) then
                list[#list + 1] = obj
            end
        end
    end

    return list
end

local function findNearestCoin(hrp)
    local coins = findAllCoins()
    local best, bestDist = nil, math.huge
    for _, coin in ipairs(coins) do
        local pos = getCoinPosition(coin)
        if pos then
            local d = (pos - hrp.Position).Magnitude
            if d < bestDist then
                bestDist = d
                best = coin
            end
        end
    end
    return best, bestDist
end

local function setStatus(msg)
    CoinFarmRuntime.lastStatus = msg
    if CoinFarmRuntime.statusLabel then
        pcall(function()
            CoinFarmRuntime.statusLabel.Text = "Status: " .. msg
                .. "  |  Collected: " .. tostring(CoinFarmRuntime.collected)
                .. "  |  Session: " .. tostring(CoinFarmRuntime.session)
        end)
    end
end

local function collectCoin(coin)
    if not coin or not coin.Parent then return false end
    local ok = pcall(function()
        coin:Destroy()
    end)
    if ok then
        CoinFarmRuntime.collected = CoinFarmRuntime.collected + 1
        CoinFarmRuntime.session   = CoinFarmRuntime.session + 1
        log("OK", "Coin collected (total this run: " .. CoinFarmRuntime.collected .. ")")
        setStatus("collected")
        return true
    end
    log("WARN", "Failed to destroy coin")
    return false
end

local function moveToPosition(hum, hrp, targetPos, gen)
    if not hum or not hrp or not targetPos then return false end
    if gen ~= CoinFarmRuntime.generation then return false end

    local oldSpeed = hum.WalkSpeed
    local speedMult = 1
    if FeatureModules.CoinCollection and FeatureModules.CoinCollection.Config then
        speedMult = FeatureModules.CoinCollection.Config.RouteSpeed or 1
    end
    pcall(function() hum.WalkSpeed = Config.PathSpeed * speedMult end)

    local start = os.clock()
    hum:MoveTo(targetPos)

    local reached = false
    local conn
    conn = hum.MoveToFinished:Connect(function()
        reached = true
        if conn then conn:Disconnect() end
    end)

    while not reached do
        if gen ~= CoinFarmRuntime.generation or not CoinFarmRuntime.running or GlobalStop then
            if conn then conn:Disconnect() end
            pcall(function() hum.WalkSpeed = oldSpeed end)
            return false
        end
        if not hrp.Parent or hum.Health <= 0 then
            if conn then conn:Disconnect() end
            pcall(function() hum.WalkSpeed = oldSpeed end)
            return false
        end
        if (hrp.Position - targetPos).Magnitude <= Config.CollectDistance then
            reached = true
            break
        end
        if os.clock() - start > Config.MoveTimeout then
            log("WARN", "MoveTo timed out after " .. Config.MoveTimeout .. "s")
            break
        end
        task.wait(0.15)
    end

    if conn then pcall(function() conn:Disconnect() end) end
    pcall(function() hum.WalkSpeed = oldSpeed end)
    return (hrp.Position - targetPos).Magnitude <= Config.CollectDistance + 2
end

local function coinFarmLoop(gen)
    log("INFO", "Coin Farm loop started (gen=" .. gen .. ")")
    setStatus("running")

    while CoinFarmRuntime.running and gen == CoinFarmRuntime.generation and not GlobalStop do
        if CoinFarmRuntime.paused then
            setStatus("paused")
            task.wait(0.4)
        else
            local char, hrp, hum = getCharacter()
            if not char then
                setStatus("waiting for character")
                log("INFO", "Waiting for character / respawn...")
                task.wait(1)
            else
                local coin, dist = findNearestCoin(hrp)
                if not coin then
                    setStatus("searching (no coins)")
                    if math.random() < 0.12 then
                        log("INFO", "No coins found – place Parts tagged '" .. Config.CoinTag
                            .. "' or named containing '" .. Config.CoinNameMatch .. "'")
                    end
                    task.wait(Config.SearchInterval)
                else
                    CoinFarmRuntime.currentTarget = coin
                    local pos = getCoinPosition(coin)
                    if not pos then
                        log("WARN", "Coin has no valid position")
                        task.wait(0.3)
                    else
                        setStatus(string.format("moving (%.0f studs)", dist or 0))
                        log("INFO", string.format("Targeting coin at distance %.1f", dist or -1))

                        local ok = moveToPosition(hum, hrp, pos, gen)
                        if gen ~= CoinFarmRuntime.generation then break end

                        local char2, hrp2 = getCharacter()
                        if char2 and hrp2 and coin.Parent then
                            local finalDist = (hrp2.Position - pos).Magnitude
                            if finalDist <= Config.CollectDistance + 1.5 then
                                collectCoin(coin)
                            else
                                log("WARN", string.format("Reached move end but still %.1f studs away", finalDist))
                                setStatus("approach failed")
                            end
                        else
                            if not coin.Parent then
                                log("INFO", "Coin disappeared before collection")
                            end
                            setStatus("target lost")
                        end
                        CoinFarmRuntime.currentTarget = nil
                    end
                    task.wait(0.2)
                end
            end
        end
    end

    setStatus("stopped")
    log("INFO", "Coin Farm loop ended (gen=" .. gen .. ")")
end

FeatureModules.CoinCollection = {
    Enabled = false,
    Config = {
        RouteSpeed = 1.0,
        PreferElevated = true,
    },
    Stats = {
        Collected = 0,
        Session = 0,
    },

    Start = function()
        if CoinFarmRuntime.running then
            log("WARN", "Coin Farm already running")
            return
        end
        CoinFarmRuntime.generation = CoinFarmRuntime.generation + 1
        local gen = CoinFarmRuntime.generation
        CoinFarmRuntime.running = true
        CoinFarmRuntime.paused = false
        CoinFarmRuntime.collected = 0
        FeatureModules.CoinCollection.Enabled = true

        log("OK", "Coin Farm ENABLED (generation " .. gen .. ")")
        setStatus("starting")

        CoinFarmRuntime.task = task.spawn(function()
            local ok, err = pcall(coinFarmLoop, gen)
            if not ok then
                log("FAIL", "Coin Farm loop error: " .. tostring(err))
                setStatus("error")
            end
            CoinFarmRuntime.running = false
            FeatureModules.CoinCollection.Enabled = false
        end)
    end,

    Pause = function()
        CoinFarmRuntime.paused = not CoinFarmRuntime.paused
        log("INFO", "Coin Farm paused = " .. tostring(CoinFarmRuntime.paused))
        setStatus(CoinFarmRuntime.paused and "paused" or "running")
    end,

    Stop = function()
        if not CoinFarmRuntime.running and CoinFarmRuntime.generation == 0 then
            return
        end
        CoinFarmRuntime.generation = CoinFarmRuntime.generation + 1
        CoinFarmRuntime.running = false
        CoinFarmRuntime.paused = false
        CoinFarmRuntime.currentTarget = nil
        FeatureModules.CoinCollection.Enabled = false
        FeatureModules.CoinCollection.Stats.Collected = CoinFarmRuntime.collected
        FeatureModules.CoinCollection.Stats.Session = CoinFarmRuntime.session

        CoinFarmRuntime.task = nil
        setStatus("stopped")
        log("OK", "Coin Farm STOPPED (collected this run: " .. CoinFarmRuntime.collected .. ")")
    end,

    GetStatus = function()
        return CoinFarmRuntime.lastStatus
    end,
}

