        local function nextOrder()
            tab._order = tab._order + 1
            return tab._order
        end

        function tab:AddHeader(title, subtitle)
            local f = new("Frame", {
                BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44),
                LayoutOrder = nextOrder(), Parent = tab.Page,
