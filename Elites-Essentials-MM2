--// Logging
local function log(msg, level)
	level = level or "INFO"
	if not State.logEnabled and level ~= "ERROR" then return end
	local timestamp = os.date("%H:%M:%S")
	local entry = string.format("[%s] [%s] %s", timestamp, level, tostring(msg))
	table.insert(State.logs, entry)
	if #State.logs > 200 then
		table.remove(State.logs, 1)
	end
	if State.refreshLogs then
		State.refreshLogs()
	end
	if level == "ERROR" or level == "WARN" then
		warn(entry)
	else
		print(entry)
	end
end

--// Helpers
local function isValidCoin(obj)
	if not obj or not obj.Parent then return false end
	if not obj:IsA("BasePart") then return false end
	return obj.Name == Config.COIN_NAME or CollectionService:HasTag(obj, Config.COIN_TAG)
end

local function findNearestCoin()
	local coins = {}
	for _, obj in ipairs(CollectionService:GetTagged(Config.COIN_TAG)) do
		if isValidCoin(obj) then
			table.insert(coins, obj)
		end
	end
	for _, obj in ipairs(workspace:GetDescendants()) do
		if isValidCoin(obj) and not table.find(coins, obj) then
			table.insert(coins, obj)
		end
	end

	if not State.hrp then return nil end

	local nearest, nearestDist = nil, math.huge
	for _, coin in ipairs(coins) do
		local dist = (State.hrp.Position - coin.Position).Magnitude
		if dist < nearestDist and coin ~= State.currentTarget then
			nearest = coin
			nearestDist = dist
		end
	end
	return nearest, nearestDist
end

local function moveTo(position, timeout)
	if not State.humanoid or not State.hrp then return false end
	timeout = timeout or Config.MOVE_TIMEOUT

	State.humanoid:MoveTo(position)
	local start = tick()

	while tick() - start < timeout do
		if not State.collecting or State.paused then
			State.humanoid:MoveTo(State.hrp.Position)
			return false
		end
		if not State.hrp or not State.hrp.Parent then return false end

		local dist = (State.hrp.Position - position).Magnitude
		if dist <= Config.COLLECT_DISTANCE then
			State.humanoid:MoveTo(State.hrp.Position)
			return true
		end

		if (tick() - start) % 1.5 < 0.05 then
			State.humanoid:MoveTo(position)
		end
		task.wait(0.1)
	end

	State.humanoid:MoveTo(State.hrp.Position)
	return false
end

local function attemptCollect(coin)
	if not isValidCoin(coin) then return false end
	if not State.hrp then return false end

	local dist = (State.hrp.Position - coin.Position).Magnitude
	if dist > Config.COLLECT_DISTANCE + 2 then
		log("Coin too far at collect time", "WARN")
		return false
	end

	collectRemote:FireServer(coin)
	log("Collection request sent")
	State.coinsCollected += 1
	return true
end

local function collectionLoop()
	log("Collection loop started")
	while State.collecting do
		if State.paused then
			task.wait(0.3)
			continue
		end

		if not State.hrp or not State.hrp.Parent or not State.humanoid or State.humanoid.Health <= 0 then
			log("Character invalid, waiting...", "WARN")
			task.wait(1)
			continue
		end

		local coin, dist = findNearestCoin()
		State.currentTarget = coin

		if not coin then
			log("No coins found")
			task.wait(Config.SEARCH_INTERVAL)
			continue
		end

		log(string.format("Targeting coin (%.1f studs)", dist or 0))

		local success = moveTo(coin.Position, Config.MOVE_TIMEOUT)
		if not success then
			log("Failed to reach coin", "WARN")
			State.currentTarget = nil
			task.wait(0.4)
			continue
		end

		if isValidCoin(coin) then
			attemptCollect(coin)
		else
			log("Coin disappeared", "WARN")
		end

		State.currentTarget = nil
		task.wait(Config.SEARCH_INTERVAL)
	end
	log("Collection loop ended")
	State.currentTarget = nil
end

local function onCharacterAdded(char)
	State.character = char
	State.humanoid = char:WaitForChild("Humanoid", 8)
	State.hrp = char:WaitForChild("HumanoidRootPart", 8)

	if State.humanoid then
		State.connections.died = State.humanoid.Died:Connect(function()
			log("Character died", "WARN")
			State.currentTarget = nil
		end)
	end
	log("Character ready")
end

