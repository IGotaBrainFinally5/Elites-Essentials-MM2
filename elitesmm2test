function UIController:MakeButton(label, callback, disabled)
    local button = create("TextButton", self.Content, {
        Size = UDim2.new(1, -4, 0, 39), BackgroundColor3 = disabled and self.Theme.Panel or self.Theme.PanelRaised,
        Text = label, TextColor3 = disabled and self.Theme.Muted or self.Theme.Text,
        Font = Enum.Font.GothamBold, TextSize = 12, AutoButtonColor = not disabled,
    })
    create("UICorner", button, { CornerRadius = UDim.new(0, 8) })
    create("UIStroke", button, { Color = self.Theme.PurpleDark, Transparency = 0.45, Thickness = 1 })
    if not disabled then self:Connect(button.Activated, function() callback(button) end) end
    return button
end

function UIController:MakeToggle(label, key, callback, requiresInspector)
    local row = create("Frame", self.Content, {
        Size = UDim2.new(1, -4, 0, 43), BackgroundColor3 = self.Theme.Panel,
    })
    create("UICorner", row, { CornerRadius = UDim.new(0, 8) })
    create("TextLabel", row, {
        Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -130, 1, 0),
        BackgroundTransparency = 1, Text = label, TextColor3 = self.Theme.Text,
        Font = Enum.Font.GothamSemibold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
    })
    local locked = requiresInspector and self.Snapshot.RoleInspectionAllowed ~= true
    local button = create("TextButton", row, {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -9, 0.5, 0),
        Size = UDim2.fromOffset(105, 28), BackgroundColor3 = locked and self.Theme.PanelRaised or (self.Settings[key] and self.Theme.PurpleDark or self.Theme.PanelRaised),
        Text = locked and "DEV ONLY" or (self.Settings[key] and self:T("enabled") or self:T("disabled")),
        TextColor3 = self.Theme.Text, Font = Enum.Font.GothamBold, TextSize = 10,
        AutoButtonColor = not locked,
    })
    create("UICorner", button, { CornerRadius = UDim.new(0, 7) })
    if not locked then
        self:Connect(button.Activated, function()
            local nextValue = not self.Settings[key]
            if callback then callback(nextValue) else self:SaveSetting(key, nextValue) end
            button.Text = nextValue and self:T("enabled") or self:T("disabled")
            button.BackgroundColor3 = nextValue and self.Theme.PurpleDark or self.Theme.PanelRaised
        end)
    else
        self:Connect(button.Activated, function()
            self:Notify(self:T("devOnly"), "Warning")
        end)
    end
    return row
end

function UIController:RenderTab(tabName)
    self.ActiveTab = tabName
    for name, button in pairs(self.TabButtons) do
        local active = name == tabName
        button.BackgroundColor3 = active and self.Theme.PurpleDark or self.Theme.Panel
        button.TextColor3 = active and self.Theme.Text or self.Theme.Muted
    end
    for _, child in ipairs(self.Content:GetChildren()) do
        if child ~= self.ContentLayout and not child:IsA("UIPadding") then child:Destroy() end
    end

    if tabName == "Overview" then
        self:MakeSection("System overview")
        self:MakeInfo(self:T("ready") .. "\nServer-authoritative prototype • " .. self.Config.Version)
        if self.Snapshot.OwnRole then
            self:MakeInfo("YOUR TEST ROLE: " .. string.upper(tostring(self.Snapshot.OwnRole)))
        end
        local stats = self.Snapshot.Stats or {}
        self:MakeInfo(string.format("Speed kills: %d     %s: %d     %s: %d     %s: %d", stats.SpeedKills or 0, self:T("kills"), stats.Kills or 0, self:T("deaths"), stats.Deaths or 0, self:T("gold"), stats.Gold or 0))
        self:MakeSection("Quick actions")
        self:MakeButton("FIRE TRAINING PISTOL", function() self:FireTrainingShot() end)
        self:MakeButton(self:T("respawn"), function()
            local character = self.Player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                self:Notify("You are already alive.", "Info")
            else
                self.Context.Remotes.Action:FireServer("RequestRespawn")
            end
        end)
        self:MakeSection("Developer note")
        self:MakeInfo("Role inspection and radar are developer-only. Add your UserId in Shared/Config.lua to enable the test tools.")

    elseif tabName == "Combat" then
        self:MakeSection("Camera and weapon feedback")
        self:MakeToggle(self:T("recoil"), "RecoilEnabled")
        self:MakeToggle(self:T("breather"), "AimBreatherEnabled")
        self:MakeToggle(self:T("crosshair"), "CrosshairEnabled")
        self:MakeInfo("The server validates each shot, enforces the weapon cooldown, raycasts from the character and calculates damage. Click the game world or use the test button to fire.")
        self:MakeButton("FIRE TRAINING PISTOL", function() self:FireTrainingShot() end)
        self:MakeSection("Last-hit feedback")
        self.LastHitLabel = self:MakeInfo("No confirmed hits this session.")

    elseif tabName == "Movement" then
        self:MakeSection("Server-controlled movement")
        self:MakeToggle(self:T("sprint"), "SprintEnabled", function(value)
            self.Context.Remotes.Action:FireServer("SetSprint", { Enabled = value })
            self.Settings.SprintEnabled = value
        end)
        self:MakeButton("JUMP PRESET: " .. tostring(self.CurrentJumpPreset or "NORMAL"), function(button)
            local presets = { "Normal", "Float", "Heavy" }
            local current = table.find(presets, self.CurrentJumpPreset or "Normal") or 1
            self.CurrentJumpPreset = presets[current % #presets + 1]
            self.Context.Remotes.Action:FireServer("SetJumpPreset", { Preset = self.CurrentJumpPreset })
            button.Text = "JUMP PRESET: " .. string.upper(self.CurrentJumpPreset)
        end)
        self:MakeToggle(self:T("boulder"), "BoulderAssistEnabled")
        self:MakeInfo("Sprint is symmetric in both directions. Boulder assist performs a normal jump only when you approach an obstacle tagged 'Boulder'. It never moves or anchors your hitbox.")

    elseif tabName == "Visuals" then
        self:MakeSection("Player information and visuals")
        self:MakeToggle(self:T("frames"), "PlayerFramesEnabled")
        self:MakeToggle(self:T("stats"), "StatViewerEnabled")
        self:MakeToggle(self:T("radar"), "RadarEnabled", function(value)
            if value and self.Snapshot.RoleInspectionAllowed ~= true then
                self:Notify(self:T("devOnly"), "Warning")
                return
            end
            self:SaveSetting("RadarEnabled", value)
        end, true)
        self:MakeToggle(self:T("identity"), "IdentityEnabled", function(value)
            if value and self.Snapshot.RoleInspectionAllowed ~= true then
                self:Notify(self:T("devOnly"), "Warning")
                return
            end
            self.Settings.IdentityEnabled = value
            self.Context.Visuals:SetIdentity(value)
        end, true)
        self:MakeInfo("Player outlines use the normal occlusion mode. Hidden roles are sent only to UserIds authorized in Config.lua.")

    elseif tabName == "Systems" then
        self:MakeSection("Visual overlays & diagnostics")
        self:MakeToggle("Black / purple camera vignette", "CameraFilterEnabled")
        self:MakeToggle("Private diagnostic console", "LogConsoleEnabled")
        self:MakeToggle("Read-only chat copy to private log", "ChatToLogEnabled")
        self:MakeToggle("Rank labels (D / C / B / A)", "RankOverlayEnabled")
        self:MakeToggle("Tagged NPC outlines", "NPCTrackingEnabled")
        self:MakeButton("CLEAR PRIVATE LOG", function()
            if self.Context.Advanced then self.Context.Advanced:ClearLogs() end
        end)
        self:MakeButton("BROADCAST TEST ANNOUNCEMENT", function()
            self.Context.Remotes.Action:FireServer("RequestAnnouncement")
            self:Notify("Announcement request sent for server validation.", "Info")
        end)
        self:MakeSection("Game integration notes")
        self:MakeInfo("Rank overlays read the Rank attribute (D/C/B/A). NPC tracking uses CollectionService tag 'ElitesNPC'. Asset preload uses only IDs supplied in Shared/Config.lua.")
        self:MakeInfo("Chat logging is read-only. Public chat is not hidden or redirected. The server validates developer announcements and emits trusted kill-feed events.")
        self:MakeInfo("Exploit hooks, anti-cheat listener blocking, fake identity, remote CFrame spoofing, automatic player aim snapping and fake death are intentionally not included.")

    elseif tabName == "Settings" then
        self:MakeSection("Personal preferences")
        self:MakeButton(self:T("language") .. ": " .. (self.Settings.Language == "es" and self:T("spanish") or self:T("english")), function(button)
            self:SaveSetting("Language", self.Settings.Language == "en" and "es" or "en")
            self:RenderTab("Settings")
        end)
        self:MakeButton("RESET LOCAL VISUAL SETTINGS", function()
            for key, value in pairs(self.Config.DefaultSettings) do
                self.Settings[key] = value
                self.Context.Remotes.Action:FireServer("SavePreference", { Key = key, Value = value })
            end
            self:ApplySettings()
            self:Notify("Visual settings reset.", "Success")
            self:RenderTab("Settings")
        end)
        self:MakeSection("Module availability")
        self:MakeInfo("Some requested modules need your own animation IDs, sound assets, round rules or tagged map objects. Their extension points are documented in README.md.")
    end
end

function UIController:FireTrainingShot()
    local camera = workspace.CurrentCamera
    if not camera then return end
    self.Context.Remotes.Action:FireServer("FireWeapon", { Direction = camera.CFrame.LookVector })
end

function UIController:Notify(message, kind)
    local color = self.Theme.Purple
    if kind == "Success" then color = self.Theme.Green end
    if kind == "Warning" then color = self.Theme.Gold end
    if kind == "Error" then color = self.Theme.Red end
    local toast = create("TextLabel", self.ToastHolder, {
        Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = self.Theme.PanelRaised,
        BackgroundTransparency = 0.06, Text = tostring(message), TextColor3 = self.Theme.Text,
        Font = Enum.Font.GothamSemibold, TextSize = 12, TextWrapped = true,
    })
    create("UICorner", toast, { CornerRadius = UDim.new(0, 8) })
    create("UIStroke", toast, { Color = color, Thickness = 1.2 })
    task.delay(2.7, function()
        if toast.Parent then
            local tween = TweenService:Create(toast, TweenInfo.new(0.25), { BackgroundTransparency = 1, TextTransparency = 1 })
            tween:Play()
            tween.Completed:Wait()
            toast:Destroy()
        end
    end)
end

function UIController:UpdateHit(data)
    if self.LastHitLabel and self.LastHitLabel.Parent then
        self.LastHitLabel.Text = string.format("HIT CONFIRMED  •  %s / %s  •  %d damage", tostring(data.Target), tostring(data.Part), tonumber(data.Damage) or 0)
    end
    self:Notify("Hit confirmed: " .. tostring(data.Target) .. " (" .. tostring(data.Damage) .. ")", "Success")
end

function UIController:UpdateStats(stats)
    self.Snapshot.Stats = stats
    self.Hud.Text = string.format("SK %d  |  K %d  D %d  |  G %d", stats.SpeedKills or 0, stats.Kills or 0, stats.Deaths or 0, stats.Gold or 0)
    if self.ActiveTab == "Overview" then self:RenderTab("Overview") end
end

function UIController:SetRoleSnapshot(snapshot)
    self.Snapshot.RoleInspectionAllowed = snapshot.RoleInspectionAllowed == true
    self.Context.Visuals:SetRoleSnapshot(snapshot)
    self:ApplySettings()
end

function UIController:SetOwnRole(role)
    self.Snapshot.OwnRole = role
    self:Notify("Your role: " .. string.upper(tostring(role)), "Info")
    if self.ActiveTab == "Overview" then self:RenderTab("Overview") end
end

function UIController:StartHudLoop()
    local function update()
        local stats = {
            Kills = self.Player:GetAttribute("Kills") or (self.Snapshot.Stats and self.Snapshot.Stats.Kills) or 0,
            Deaths = self.Player:GetAttribute("Deaths") or (self.Snapshot.Stats and self.Snapshot.Stats.Deaths) or 0,
            Gold = self.Player:GetAttribute("Gold") or (self.Snapshot.Stats and self.Snapshot.Stats.Gold) or 0,
            SpeedKills = self.Player:GetAttribute("SpeedKills") or (self.Snapshot.Stats and self.Snapshot.Stats.SpeedKills) or 0,
        }
        self.Hud.Text = string.format("SK %d  |  K %d  D %d  |  G %d", stats.SpeedKills, stats.Kills, stats.Deaths, stats.Gold)
    end
    self:Connect(self.Player:GetAttributeChangedSignal("Kills"), update)
    self:Connect(self.Player:GetAttributeChangedSignal("Deaths"), update)
    self:Connect(self.Player:GetAttributeChangedSignal("Gold"), update)
    self:Connect(self.Player:GetAttributeChangedSignal("SpeedKills"), update)
    update()
end

function UIController:StartRadarLoop()
    task.spawn(function()
        while self.Gui and self.Gui.Parent do
            local isEnabled = self.Settings.RadarEnabled and self.Snapshot.RoleInspectionAllowed == true
            self.Radar.Visible = isEnabled
            if isEnabled then
                for _, dot in ipairs(self.RadarDots) do dot:Destroy() end
                table.clear(self.RadarDots)
                local character = self.Player.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                if root then
                    for _, other in ipairs(Players:GetPlayers()) do
                        if other ~= self.Player then
                            local otherRoot = other.Character and other.Character:FindFirstChild("HumanoidRootPart")
                            if otherRoot then
                                local offset = otherRoot.Position - root.Position
                                local x = math.clamp(offset.X / 150, -0.43, 0.43)
                                local z = math.clamp(offset.Z / 150, -0.43, 0.43)
                                local dot = create("Frame", self.Radar, {
                                    Size = UDim2.fromOffset(5, 5),
                                    Position = UDim2.new(0.5 + x, -2, 0.5 + z, -1),
                                    BackgroundColor3 = self.Theme.Red, BorderSizePixel = 0,
                                })
                                create("UICorner", dot, { CornerRadius = UDim.new(1, 0) })
                                table.insert(self.RadarDots, dot)
                            end
                        end
                    end
                end
            end
            task.wait(0.2)
        end
    end)
end

return UIController

