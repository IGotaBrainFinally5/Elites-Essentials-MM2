local Players = game:GetService("Players")

local VisualController = {}
VisualController.__index = VisualController

local ROLE_COLORS = {
    Murderer = Color3.fromRGB(255, 75, 100),
    Sheriff = Color3.fromRGB(90, 170, 255),
    Innocent = Color3.fromRGB(115, 225, 160),
}

function VisualController.new(localPlayer)
    local self = setmetatable({}, VisualController)
    self.LocalPlayer = localPlayer
    self.FramesEnabled = false
    self.StatsEnabled = false
    self.IdentityEnabled = false
    self.RoleInspectionAllowed = false
    self.Roles = {}
    self.Tracked = {}

    local function bindPlayer(player)
        if player == self.LocalPlayer then return end
        local function bindCharacter(character)
            self:RefreshCharacter(player, character)
        end
        player.CharacterAdded:Connect(bindCharacter)
        if player.Character then bindCharacter(player.Character) end
    end
    for _, player in ipairs(Players:GetPlayers()) do bindPlayer(player) end
    Players.PlayerAdded:Connect(bindPlayer)
    Players.PlayerRemoving:Connect(function(player)
        self:ClearPlayer(player)
    end)
    return self
end

function VisualController:ClearPlayer(player)
    local record = self.Tracked[player]
    if record then
        if record.Highlight then record.Highlight:Destroy() end
        if record.Billboard then record.Billboard:Destroy() end
        self.Tracked[player] = nil
    end
end

function VisualController:RefreshCharacter(player, character)
    self:ClearPlayer(player)
    local record = {}
    self.Tracked[player] = record

    local highlight = Instance.new("Highlight")
    highlight.Name = "ElitesPhantomFrame"
    highlight.Adornee = character
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.FillTransparency = 0.88
    highlight.OutlineTransparency = 0.08
    highlight.Enabled = self.FramesEnabled
    highlight.Parent = character
    record.Highlight = highlight

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ElitesStatViewer"
    billboard.Size = UDim2.fromOffset(150, 42)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = false
    billboard.Enabled = self.StatsEnabled
    billboard.Adornee = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    billboard.Parent = character

    local label = Instance.new("TextLabel")
    label.Name = "Info"
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundColor3 = Color3.fromRGB(15, 11, 24)
    label.BackgroundTransparency = 0.18
    label.TextColor3 = Color3.fromRGB(245, 240, 255)
    label.TextStrokeTransparency = 0.6
    label.Font = Enum.Font.GothamSemibold
    label.TextSize = 12
    label.Text = player.DisplayName
    label.Parent = billboard
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = label
    record.Billboard = billboard
    record.Label = label

    task.spawn(function()
        while character.Parent and self.Tracked[player] == record do
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local level = player:GetAttribute("Level")
            local eyesOpen = character:GetAttribute("EyesOpen")
            local line = player.DisplayName
            if humanoid then
                line ..= string.format("  |  HP %d", math.max(0, math.floor(humanoid.Health)))
            end
            if typeof(level) == "number" then line ..= "  |  Lv " .. tostring(math.floor(level)) end
            if typeof(eyesOpen) == "boolean" then line ..= eyesOpen and "  |  Eyes open" or "  |  Eyes closed" end
            label.Text = line
            task.wait(0.25)
        end
    end)
    self:ApplyRecord(player, record)
end

function VisualController:ApplyRecord(player, record)
    if not record then return end
    if record.Highlight then
        record.Highlight.Enabled = self.FramesEnabled
        local role = self.Roles[tostring(player.UserId)]
        local color = self.IdentityEnabled and self.RoleInspectionAllowed and ROLE_COLORS[role] or Color3.fromRGB(166, 112, 255)
        record.Highlight.OutlineColor = color
        record.Highlight.FillColor = color
    end
    if record.Billboard then
        record.Billboard.Enabled = self.StatsEnabled
    end
end

function VisualController:SetFrames(enabled)
    self.FramesEnabled = enabled == true
    for player, record in pairs(self.Tracked) do self:ApplyRecord(player, record) end
end

function VisualController:SetStats(enabled)
    self.StatsEnabled = enabled == true
    for player, record in pairs(self.Tracked) do self:ApplyRecord(player, record) end
end

function VisualController:SetRoleSnapshot(snapshot)
    if type(snapshot) ~= "table" then return end
    self.RoleInspectionAllowed = snapshot.RoleInspectionAllowed == true
    self.Roles = type(snapshot.Roles) == "table" and snapshot.Roles or {}
    for player, record in pairs(self.Tracked) do self:ApplyRecord(player, record) end
end

function VisualController:SetIdentity(enabled)
    self.IdentityEnabled = enabled == true and self.RoleInspectionAllowed
    for player, record in pairs(self.Tracked) do self:ApplyRecord(player, record) end
end

return VisualController

