------------------------------------------------------------------
-- 6. farming functions
------------------------------------------------------------------
local function getHRP()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function isCollectiblePart(obj)
    if not obj:IsA("BasePart") then return false end
    local char = player.Character
    if char and obj:IsDescendantOf(char) then return false end
    local lower = obj.Name:lower()
    for _, needle in ipairs(CONFIG.matchNames) do
        if lower:find(needle, 1, true) then return true end
    end
    return false
end

local function findCollectibles()
    local list = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isCollectiblePart(obj) then
            table.insert(list, obj)
        end
    end
    return list
end

local function resetCharacter()
    local hum = getHumanoid()
    if hum and hum.Health > 0 then
        hum.Health = 0
        return true
    end
    return false
end

local function setStatus(text, color)
    if statusLabel and statusLabel.Parent then
        statusLabel.Text = text
        if color then statusLabel.TextColor3 = color end
    end
end

local function farmLoop()
    state.noCoinTimer = 0
    while state.enabled do
        local ok, err = pcall(function()
            local hrp = getHRP()
            if not hrp then
                setStatus("no character — waiting", Color3.fromRGB(200, 180, 100))
                return
            end

            local hum = getHumanoid()
            local alive = hum and hum.Health > 0

            local items = findCollectibles()
            if #items > 0 then
                state.noCoinTimer = 0
                local count = 0
                for _, item in ipairs(items) do
                    if not state.enabled then break end
                    if item and item.Parent and item:IsA("BasePart") then
                        local h = getHRP()
                        if not h then break end
                        h.CFrame = item.CFrame
                        count += 1
                        setStatus(
                            string.format("collected %d | last: %s", count, item.Name),
                            Color3.fromRGB(120, 220, 140)
                        )
                        task.wait(CONFIG.collectDelay)
                    end
                end
                setStatus(
                    string.format("pass done: %d items", count),
                    Color3.fromRGB(120, 220, 140)
                )
            else
                state.noCoinTimer += CONFIG.scanInterval
                local left = math.max(0, CONFIG.noCoinReset - state.noCoinTimer)
                if alive then
                    setStatus(
                        string.format("no items — reset in %.1fs", left),
                        Color3.fromRGB(200, 180, 100)
                    )
                else
                    setStatus(
                        string.format("dead — waiting (%.1fs)", left),
                        Color3.fromRGB(170, 170, 180)
                    )
                end

                if state.noCoinTimer >= CONFIG.noCoinReset then
                    if alive and CONFIG.autoReset then
                        setStatus("resetting...", Color3.fromRGB(200, 120, 120))
                        resetCharacter()
                        state.noCoinTimer = 0
                        task.wait(CONFIG.noCoinReset)  -- cooldown between resets
                    else
                        state.noCoinTimer = 0
                    end
                end
            end
        end)

        if not ok then
            log("ERR", "farm loop error: " .. tostring(err))
            setStatus("farm error — check console", Color3.fromRGB(255, 120, 120))
        end

        task.wait(CONFIG.scanInterval)
    end
end

local function startFarm()
    if state.enabled then return end
    state.enabled = true
    if toggleBtn then
        toggleBtn.Text = "ON"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(45, 190, 70)
    end
    setStatus("running...", Color3.fromRGB(120, 220, 140))
    log("INFO", "farm started")
    state.farmThread = task.spawn(farmLoop)
end

local function stopFarm()
    state.enabled = false
    if toggleBtn then
        toggleBtn.Text = "OFF"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(190, 50, 50)
    end
    setStatus("idle", Color3.fromRGB(170, 170, 180))
    log("INFO", "farm stopped")
end

-- wire toggle
if toggleBtn then
    toggleBtn.MouseButton1Click:Connect(function()
        if state.enabled then stopFarm() else startFarm() end
    end)
end

-- wire diagnostics print
local printBtnRef = frame:FindFirstChild("PrintDiag")
if printBtnRef then
    printBtnRef.MouseButton1Click:Connect(function()
        print("===== MM2-DIAG REPORT =====")
        for _, line in ipairs(diagLog) do
            print(line)
        end
        print("gui.Parent        =", gui.Parent and gui.Parent:GetFullName() or "nil")
        print("gui.Enabled       =", gui.Enabled)
        print("gui.DisplayOrder  =", gui.DisplayOrder)
        print("gui.AbsoluteSize  =", tostring(gui.AbsoluteSize))
        print("frame.AbsoluteSize=", tostring(frame.AbsoluteSize))
        print("frame.Position    =", tostring(frame.Position))
        print("farm.enabled      =", tostring(state.enabled))
        print("noCoinTimer       =", tostring(state.noCoinTimer))

        local matches = findCollectibles()
        print("workspace parts   =", #workspace:GetDescendants())
        print("coin matches      =", #matches)
        if #matches > 0 then
            local names = {}
            for i = 1, math.min(#matches, 10) do
                names[#names + 1] = matches[i].Name
            end
            print("matched names     =", table.concat(names, ", "))
        else
            -- dump nearby part names to help identify coin naming
            local samples = {}
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") then
                    samples[#samples + 1] = obj.Name
                    if #samples >= 25 then break end
                end
            end
            print("sample part names =", table.concat(samples, ", "))
        end

        local cam = workspace.CurrentCamera
        print("ViewportSize      =", cam and tostring(cam.ViewportSize) or "no camera")
        print("===========================")
    end)
end

