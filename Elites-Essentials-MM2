local function parseColor(str)
	local r, g, b = str:match("(%d+)%s*,%s*(%d+)%s*,%s*(%d+)")
	if r and g and b then
		return Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b))
	end
	return nil
end

local function updateStatus()
	if State.collecting then
		statusLabel.Text = State.paused and "Status: Paused" or "Status: Collecting"
	else
		statusLabel.Text = "Status: Stopped"
	end
	collectedLabel.Text = "Collected: " .. State.coinsCollected
	if State.currentTarget and State.currentTarget.Parent then
		targetLabel.Text = "Target: Active"
	else
		targetLabel.Text = "Target: None"
	end
end

State.refreshLogs = function()
	local text = table.concat(State.logs, "\n")
	logText.Text = text
	logText.Size = UDim2.new(1, -8, 0, math.max(200, #State.logs * 14))
	logScroll.CanvasSize = UDim2.fromOffset(0, logText.AbsoluteSize.Y + 10)
end

